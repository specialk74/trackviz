%% # Scene 04 — a carrier expected in the Pit-Lane never arrives: Clear (turnstile)
%% # Same situation as scene 03, with the turnstile, gate and antenna of scene 02.
%% # C2 is believed to be diverted (Prepare is sent) but physically goes straight
%% # on the Main-Lane; its logical position is a dashed ghost ("C2L"). C3 stops at
%% # the antenna on top of the ghost while C1 is being sampled. As soon as the
%% # antenna reads C3, the interface sends Clear for C2; after the analyzer's reply
%% # it sends Prepare again (purple) for C3, which then waits at the gate for
%% # Sample Complete as usual.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry turnstile
%% subtitle A carrier expected in the Pit-Lane is missing — Clear (turnstile with gate and antenna)
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123 route=main_in,pit_entry,pit_exit,gone
    %% # The real C2: it is not diverted and goes straight on the Main-Lane.
    %% carrier id=C2 sid=SID-000124 route=spawn,gone color=#0EA5E9
    %% # Where the interface believes C2 is: diverted into the Pit-Lane, up to the antenna.
    %% carrier id=C2L sid=SID-000124 route=nsd,pit_wait color=#0EA5E9 ghost hidden tag=SID-000124_(expected)
    %% carrier id=C3 sid=SID-000125 route=spawn,pit_entry,pit_exit,gone color=#DB2777

    %% caption 1 · Turnstile with gate and antenna | Three carriers holding sample tubes travel towards the interface. Every carrier diverted into the Pit-Lane stops at the antenna in front of the gate and the turnstile.
    %% at 2.6
    %% move C1 to pit_wait
    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare — antenna | The first carrier is diverted without stopping (Prepare) and read at the antenna (Prepare again). Nothing is being sampled, so the gate opens, the carrier enters and the wheel brings it under the needle.
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1
    %% id ok-c1
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.5 antenna2 C1
    %% color #9333EA
    %% id prepare-c1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1 ok-c1
    %% id query-c1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.1 prepare-c1
    %% for C1
    %% id ok-c1-2
    AN-->>IF: OK
    %% after 0.1 query-c1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 ok-c1-2
    %% pass antenna2
    %% after 0.15
    %% rotate ts
    %% after 0.25
    %% caption 3 · Sample Acquisition | The first carrier is under the needle: Sample Acquisition, and the analyzer aspirates.
    %% after 0.25 rotate ts
    %% id sample-acquisition-c1
    IF->>AN: Sample Acquisition SampleId=SID-000123

    %% at 12.9
    %% move C2 to gone
    %% after 0.1 sample-acquisition-c1
    %% for C1
    %% id ok-c1-3
    AN-->>IF: OK
    %% on antenna1 C2
    %% caption 4 · Physically straight, logically diverted | The second carrier should be diverted too, and the interface sends Prepare. But physically it goes straight on the Main-Lane: the dashed outline is where the interface believes it is.
    %% on antenna1 C2
    %% show C2L duration=0.4
    %% on antenna1 C2
    %% move C2L to pit_wait
    %% on antenna1
    %% id prepare-c2
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.1 ok-c1-3
    %% pipette ts duration=10 sid=SID-000123
    %% after 0.1 prepare-c2
    %% id ok-c2
    AN-->>IF: OK SampleId=SID-000124

    %% at 15.9
    %% move C3 to pit_wait
    %% on antenna1 C3
    %% caption 5 · Third carrier — Clear | The third carrier is diverted (Prepare) and stops at the antenna on top of the second one, which is not there. The antenna reads the third sample instead of the second: the interface sends Clear for the second.
    %% on antenna1
    %% id prepare-c3
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 ok-c2
    %% id query-c2
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 prepare-c3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.2 antenna2 C3
    %% id clear-c2
    IF->>AN: Clear SampleId=SID-000124
    %% after 0.1 query-c2
    %% id tests-to-perform-c2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1 clear-c2
    %% id ok-c2-2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.1 tests-to-perform-c2
    %% id query-c3
    AN->>DMX: Query SampleId=SID-000125
    %% after 0 ok-c2-2
    %% hide C2L duration=0.6
    %% after 0 ok-c2-2
    %% caption 6 · Prepare again for the third carrier | Only after the reply to Clear the interface sends Prepare again for the third carrier. It waits at the closed gate until the first sample is complete.
    %% after 0.2 ok-c2-2
    %% color #9333EA
    %% id prepare-c3-2
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 query-c3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.1 prepare-c3-2
    %% for C3
    AN-->>IF: OK
    %% after 0.2 pipette ts
    %% caption 7 · Sample Complete — enter — rotate | Sample Complete for the first sample. The gate opens, the third carrier enters the wheel, then the wheel rotates: the third sample goes under the needle, the first one to the exit.
    %% after 0.2 pipette ts
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1
    %% for C1
    IF-->>AN: OK
    %% pass antenna2
    %% after 0.15
    %% rotate ts
    %% after 0.15
    %% move C1 to gone
    %% after 0.25 rotate ts
    %% id sample-acquisition-c3
    IF->>AN: Sample Acquisition SampleId=SID-000125
    %% on antenna3
    %% id release-c1
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1 sample-acquisition-c3
    %% for C3
    %% id ok-c3
    AN-->>IF: OK
    %% after 0.1 release-c1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 ok-c3
    %% pipette ts duration=4.5 sid=SID-000125
    %% after 0.2
    %% caption 8 · Back to normal | The first carrier has left the interface module: Release. Sample Complete for the third sample: the wheel brings it to the exit, and once it has left the module the interface sends Release.
    %% after 0.2 pipette ts
    AN->>IF: Sample Complete SampleId=SID-000125
    %% after 0.1
    %% for C3
    IF-->>AN: OK
    %% rotate ts
    %% after 0.2
    %% move C3 to gone
    %% on antenna3
    IF->>AN: Release SampleId=SID-000125
    %% after 0.1
    %% for C3
    %% id ok-c3-2
    AN-->>IF: OK
    %% after 0.5
    %% caption 9 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 ok-c3-2
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000125
