%% # Scene 16 — spur with two needles, carrier run-away on needle 1
%% # C1 runs away before needle 1 goes down, C2 slides under it and is aspirated instead. On
%% # Sample Complete the interface sends Cancel, Clear All after the reply and empties that
%% # pit-lane (red until then). Needle 2 goes on.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with two sampling points — carrier run-away on needle 1, Cancel and Clear All
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120 color=#0EA5E9
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120 color=#DB2777
    %% # The carrier for needle 2 travels second.
    %% carrier C4 SID-000126 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120 color=#16A34A

    %% at 0
    %% caption 1 · Four carriers | Three carriers need needle 1, one needs needle 2. Each one gets Prepare when it enters the spur and Prepare again at the divert that sends it to its needle.
    %% at 1
    %% move C1 to nsd ease=in
    %% at 1.6
    %% move C4 to nsd ease=linear
    %% when C1 at nsd
    %% highlight nsd duration=1.6
    %% when C1 at nsd
    IF->>AN: Prepare SampleId=SID-000123
    %% when C1 at nsd
    %% move C1 to d1 ease=out
    %% when C4 at nsd
    %% move C4 to w1 ease=out
    %% when C4 at nsd
    %% highlight nsd duration=1.6
    %% when C4 at nsd
    IF->>AN: Prepare SampleId=SID-000126
    %% at 3.6
    %% move C2 to nsd ease=linear
    %% when prepare C1 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000123
    %% when prepare C4 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000126
    %% when C2 at nsd
    %% move C2 to w1b ease=out
    %% when C2 at nsd
    %% highlight nsd duration=1.6
    %% when C2 at nsd
    IF->>AN: Prepare SampleId=SID-000124
    %% at 5.6
    %% move C3 to nsd ease=linear
    %% when sample_ok C1 arrived
    %% delay 0.2
    AN->>DMX: Query SampleId=SID-000123
    %% when prepare C2 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000124
    %% when C3 at nsd
    %% move C3 to w1c ease=out
    %% when C3 at nsd
    %% highlight nsd duration=1.6
    %% when C3 at nsd
    IF->>AN: Prepare SampleId=SID-000125
    %% when query C1 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% when C1 at d1
    %% highlight div1 duration=0.6
    %% when C1 at d1
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare_again C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when prepare C3 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000125
    %% when C1 at d1
    %% delay 0.6
    %% move C1 to s1 ease=inout
    %% when tests C1 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000126
    %% when C4 at w1
    %% delay 1.376
    %% move C4 to d1 ease=inout
    %% when C2 at w1b
    %% delay 0.523
    %% move C2 to w1 ease=inout
    %% when C4 at d1
    %% highlight div1 duration=0.6
    %% when query C4 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000126
    %% when C4 at d1
    %% delay 0.401
    %% move C4 to d2 ease=inout
    %% when C3 at w1c
    %% delay 0.556
    %% move C3 to w1b ease=inout
    %% when C2 at w1
    %% delay 1.139
    %% move C2 to d1 ease=inout
    %% when tests C4 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000124
    %% when query C2 sent
    %% delay 0.06
    %% caption 2 · Sample Acquisition | The first carrier is at sampling point 1: Sample Acquisition with Needle=1. The next ones queue up behind it; the one for needle 2 goes on.
    %% when C1 at s1
    %% delay 0.3
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=1
    %% when sample_acquisition_needle C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when C3 at w1b
    %% delay 0.353
    %% move C3 to w1 ease=inout
    %% when C2 at d1
    %% highlight div1 duration=0.6
    %% when C2 at d1
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare_again C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when C2 at d1
    %% delay 0.601
    %% move C2 to q1 ease=inout
    %% when query C2 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% when C4 at d2
    %% highlight div2 duration=0.6
    %% when C4 at d2
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000126
    %% when prepare_again C4 arrived
    %% delay 0.1
    %% for C4
    AN-->>IF: OK
    %% when C3 at w1
    %% delay 1.239
    %% move C3 to d1 ease=inout
    %% when C4 at d2
    %% delay 0.6
    %% move C4 to s2 ease=inout
    %% when C3 at d1
    %% highlight div1 duration=0.6
    %% when C3 at d1
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000125
    %% when prepare_again C3 arrived
    %% delay 0.1
    %% for C3
    AN-->>IF: OK
    %% when tests C2 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000125
    %% when C3 at d1
    %% delay 0.601
    %% move C3 to q2 ease=inout
    %% when sample_acquisition_needle C1 arrived
    %% delay 2.187
    %% move C1 to d2 ease=inout speed=170 runaway
    %% when C2 at q1
    %% delay 0.202
    %% caption 3 · Carrier run-away | Before needle 1 goes down the first carrier runs away. The interface notices it: that part of the interface turns red. The next carrier slides under needle 1.
    %% when C2 at q1
    %% delay 0.202
    %% status zone1 error
    %% when C2 at q1
    %% delay 1.1
    %% move C2 to s1 ease=inout
    %% when query C3 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% when C3 at q2
    %% delay 0.1
    %% move C3 to q1 ease=inout
    %% when C4 at s2
    %% delay 0.2
    IF->>AN: Sample Acquisition SampleId=SID-000126 Needle=2
    %% when sample_acquisition_needle C4 arrived
    %% delay 0.1
    %% for C4
    AN-->>IF: OK
    %% when C3 at q1
    %% delay 0.296
    %% pipette sp1 duration=4
    %% when C1 at d2
    %% highlight div2 duration=0.6
    %% when C1 at d2
    %% delay 0.3
    %% move C1 to gone ease=linear speed=170 runaway
    %% when analyzer_ok C4 arrived
    %% delay 0.1
    %% pipette sp2 duration=4
    %% when pipette sp1 done
    %% delay 0.2
    %% caption 4 · Sample Complete — Cancel | The analyzer sends Sample Complete for the first sample, but needle 1 aspirated the second one. The interface sends Cancel for the first sample, and the analyzer replies OK.
    %% when pipette sp1 done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=1
    %% when sample_complete_needle C1 arrived
    %% delay 0.1
    %% for C1
    IF-->>AN: OK
    %% when pipette sp2 done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000126 Needle=2
    %% when sample_complete_needle C4 arrived
    %% delay 0.1
    %% for C4
    IF-->>AN: OK
    %% when sample_complete_needle C1 arrived
    %% delay 0.2
    IF->>AN: Cancel SampleId=SID-000123
    %% when interface_ok C1 sent
    %% delay 0.76
    %% move C4 to pt2u ease=in
    %% when C4 at pt2u
    %% move C4 to merge ease=linear
    %% when cancel C1 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000123
    %% when sample_ok C1 arrived
    %% delay 0.1
    IF->>AN: Clear All
    %% when sample_ok C1 arrived
    %% delay 0.2
    %% caption 5 · Pit-lane emptied — Clear All | Right after the reply to Cancel: Clear All, which cancels every Prepare. The carriers of needle 1 are sent away without sampling; once they have left its pit-lane, it turns grey.
    %% when sample_ok C1 arrived
    %% delay 0.2
    %% move C2 to d2 ease=inout
    %% when clear_all sent
    %% delay 1.7
    AN-->>IF: OK
    %% when C2 at d2
    %% highlight div2 duration=0.6
    %% when C2 at d2
    %% delay 0.401
    %% move C2 to rj2 ease=in
    %% when sample_ok C1 arrived
    %% delay 5.755
    %% move C3 to d2 ease=inout
    %% when C2 at rj2
    %% delay 0.001
    %% move C2 to merge ease=linear
    %% when C4 at merge
    %% delay 0.001
    %% move C4 to gone ease=out
    %% when C4 at iface_out
    IF->>AN: Release SampleId=SID-000126
    %% when release C4 arrived
    %% delay 0.1
    %% for C4
    AN-->>IF: OK
    %% when release C4 arrived
    %% delay 0.601
    %% status zone1 normal
    %% when C3 at d2
    %% highlight div2 duration=0.6
    %% when C3 at d2
    %% delay 0.4
    %% move C3 to rj2 ease=in
    %% when C3 at rj2
    %% move C3 to merge ease=linear
    %% when C2 at merge
    %% move C2 to gone ease=out
    %% when C3 at merge
    %% move C3 to gone ease=out
    %% when analyzer_ok C4 arrived
    %% delay 0.5
    %% caption 6 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% when analyzer_ok C4 arrived
    %% delay 0.5
    AN->>DMX: Results SampleId=SID-000126
