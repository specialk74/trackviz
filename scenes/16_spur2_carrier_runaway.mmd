%% # Scene 16 — spur with two needles, carrier run-away on needle 1
%% # C1 runs away before needle 1 goes down, C2 slides under it and is aspirated instead. On
%% # Sample Complete the interface sends Cancel, Clear All after the reply and empties that
%% # pit-lane (red until then). Needle 2 goes on.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with two sampling points — carrier run-away on needle 1, Cancel and Clear All
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone color=#0EA5E9
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone color=#DB2777
    %% # The carrier for needle 2 travels second.
    %% carrier C4 SID-000126 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone color=#16A34A

    %% caption 1 · Four carriers | Three carriers need needle 1, one needs needle 2. Each one gets Prepare when it enters the spur and Prepare again at the divert that sends it to its needle.
    %% at 1
    %% move C1 to nsd
    %% at 1.39
    %% move C4 to nsd
    %% on antenna1 C1
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% on antenna1
    %% move C1 to d1
    %% on antenna1
    %% move C4 to d1
    %% on antenna1 C4
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000126
    %% after 0.2 Prepare C1
    AN-->>IF: OK SampleId=SID-000123
    %% at 3.39
    %% move C2 to nsd
    %% on antenna2 C1
    %% highlight div1 duration=0.6
    %% after 0.1 antenna2 C1
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.2 Prepare C4
    AN-->>IF: OK SampleId=SID-000126
    %% on antenna1
    %% move C2 to d1
    %% on antenna1 C2
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.6 antenna2 C1
    %% move C1 to s1
    %% on antenna2 C4
    %% highlight div1 duration=0.6
    %% after 0.2 OK C1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.401 antenna2 C4
    %% move C4 to d2
    %% at 5.39
    %% move C3 to nsd
    %% after 0.1 Prepare C1
    %% for C1
    AN-->>IF: OK
    %% after 0.3 antenna3 C1
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=1
    %% after 0.3 antenna3 C1
    %% caption 2 · Sample Acquisition | The first carrier is at sampling point 1: Sample Acquisition with Needle=1. The next ones queue up behind it; the one for needle 2 goes on.
    %% after 0.2 Prepare C2
    AN-->>IF: OK SampleId=SID-000124
    %% on antenna1
    %% move C3 to d1
    %% on antenna1 C3
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000125
    %% on antenna4 C4
    %% highlight div2 duration=0.6
    %% after 0.1 antenna4 C4
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000126
    %% after 0.2 Query C1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% on antenna2 C2
    %% highlight div1 duration=0.6
    %% after 0.1 antenna2 C2
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.6 antenna4 C4
    %% move C4 to s2
    %% after 0.601 antenna2 C2
    %% move C2 to s1
    %% after 0.1 Sample Acquisition C1
    %% for C1
    AN-->>IF: OK
    %% after 0.2 Prepare C3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 Prepare C4
    %% for C4
    AN-->>IF: OK
    %% after 0.1 Tests to perform C1
    AN->>DMX: Query SampleId=SID-000126
    %% after 0.2 antenna5 C4
    IF->>AN: Sample Acquisition SampleId=SID-000126 Needle=2
    %% after 0.1 Prepare C2
    %% for C2
    AN-->>IF: OK
    %% on antenna2 C3
    %% highlight div1 duration=0.6
    %% after 0.1 antenna2 C3
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.601 antenna2 C3
    %% move C3 to q1
    %% after 2.187 Sample Acquisition C1
    %% move C1 to d2 runaway
    %% after 2.187 Sample Acquisition C1
    %% caption 3 · Carrier run-away | Before needle 1 goes down the first carrier runs away. The interface notices it: that part of the interface turns red. The next carrier slides under needle 1.
    %% after 2.187 Sample Acquisition C1
    %% status zone1 error
    %% after 0.2 Query C4
    DMX-->>AN: Tests to perform SampleId=SID-000126
    %% after 0.1 Sample Acquisition C4
    %% for C4
    AN-->>IF: OK
    %% after 0.1 Prepare C3
    %% for C3
    AN-->>IF: OK
    %% after 1 antenna3 C2
    %% pipette sp1 duration=4
    %% on antenna4 C1
    %% highlight div2 duration=0.6
    %% after 0.1 Tests to perform C4
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.3 antenna4 C1
    %% move C1 to gone runaway
    %% after 0.1 OK C4
    %% pipette sp2 duration=4
    %% after 0.2 Query C2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1
    AN->>DMX: Query SampleId=SID-000125
    %% after 0.2 pipette sp1
    %% caption 4 · Sample Complete — Cancel | The analyzer sends Sample Complete for the first sample, but needle 1 aspirated the second one. The interface sends Cancel for the first sample, and the analyzer replies OK.
    %% after 0.2 pipette sp1
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=1
    %% after 0.2 pipette sp2
    AN->>IF: Sample Complete SampleId=SID-000126 Needle=2
    %% after 0.2 Query C3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.1 Sample Complete C1
    %% for C1
    IF-->>AN: OK
    %% after 0.2 Sample Complete C1
    IF->>AN: Cancel SampleId=SID-000123
    %% after 0.1 Sample Complete C4
    %% for C4
    IF-->>AN: OK
    %% after 0 OK C1
    %% move C4 to gone
    %% after 0.2 Cancel C1
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.1
    IF->>AN: Clear All
    %% after 0.2 OK C1
    %% caption 5 · Pit-lane emptied — Clear All | Right after the reply to Cancel: Clear All, which cancels every Prepare. The carriers of needle 1 are sent away without sampling; once they have left its pit-lane, it turns grey.
    %% after 0.2 OK C1
    %% move C2 to d2
    %% after 0.2 Clear All
    AN-->>IF: OK
    %% on antenna4 C2
    %% highlight div2 duration=0.6
    %% after 0.401 antenna4 C2
    %% move C2 to gone
    %% on antenna6
    IF->>AN: Release SampleId=SID-000126
    %% after 0.2 OK C1
    %% move C3 to d2
    %% after 0.1 Release C4
    %% for C4
    AN-->>IF: OK
    %% after 0.601 Release C4
    %% status zone1 normal
    %% on antenna4 C3
    %% highlight div2 duration=0.6
    %% after 0.5 OK C4
    %% caption 6 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 OK C4
    AN->>DMX: Results SampleId=SID-000126
    %% after 0.4 antenna4 C3
    %% move C3 to gone
