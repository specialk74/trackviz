%% # Scene 03 — a carrier expected in the Pit-Lane never arrives: Clear (sampling point)
%% # C1 and C3 are diverted into the Pit-Lane. C2 is believed to be diverted
%% # (Prepare is sent) but physically goes straight on the Main-Lane. Its logical
%% # position is shown as a dashed ghost ("C2L") following the Pit-Lane: C3 queues
%% # on top of it, because physically the ghost is not there. When C3 reaches the
%% # sampling point, the interface sends Clear for C2 and, after the analyzer's
%% # reply, Sample Acquisition for C3.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry sampling_queue
%% subtitle A carrier expected in the Pit-Lane is missing — Clear (sampling point)
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123
    %% # The real C2: it is not diverted and goes straight on the Main-Lane.
    %% carrier id=C2 sid=SID-000124 color=#0EA5E9
    %% # Where the interface believes C2 is: diverted into the Pit-Lane.
    %% carrier id=C2L sid=SID-000124 start=antenna1 color=#0EA5E9 ghost hidden tag=SID-000124_(expected)
    %% carrier id=C3 sid=SID-000125 color=#DB2777

    %% caption 1 · Three carriers | Three carriers holding sample tubes travel on the Main-Lane towards the analyzer interface.
    %% at 2.2
    %% move C1 to antenna2
    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare — Sample Acquisition | The first carrier is diverted into the Pit-Lane without stopping (Prepare) and stopped by the gate on the sampling point: Sample Acquisition, then the analyzer aspirates.
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1
    %% id ok-c1
    AN-->>IF: OK SampleId=SID-000123

    %% at 4.9
    %% move C2 to gone
    %% on antenna2
    %% id sample-acquisition-c1
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.1 ok-c1
    %% id query-c1
    AN->>DMX: Query SampleId=SID-000123
    %% # C2 reaches the NSD: logically diverted (ghost appears), physically straight on.
    %% on antenna1 C2
    %% caption 3 · Physically straight, logically diverted | The second carrier should be diverted too, and the interface sends Prepare. But physically it goes straight on the Main-Lane: the dashed outline is where the interface believes it is.
    %% on antenna1 C2
    %% show C2L duration=0.4
    %% on antenna1 C2
    %% move C2L to queue
    %% on antenna1
    %% id prepare-c2
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.1 sample-acquisition-c1
    %% for C1
    %% id ok-c1-2
    AN-->>IF: OK

    %% at 7.9
    %% move C3 to queue
    %% after 0.1 query-c1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 prepare-c2
    %% id ok-c2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.1 ok-c1-2
    %% pipette antenna2 duration=5 sid=SID-000123
    %% on antenna1 C3
    %% caption 4 · Third carrier — one position, two carriers | The third carrier is diverted (Prepare) and stops in the queue on the same position as the second one: the second is not physically there, it went straight on along the Main-Lane.
    %% on antenna1
    %% id prepare-c3
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 ok-c2
    %% id query-c2
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 prepare-c3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 query-c2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1
    %% id query-c3
    AN->>DMX: Query SampleId=SID-000125

    %% after 0.3 pipette antenna2
    %% caption 5 · Sample Complete | Sampling is finished: Sample Complete. The first carrier is released, and the queue moves up to the sampling point.
    %% after 0.3 pipette antenna2
    %% id sample-complete-c1
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1 query-c3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.1 sample-complete-c1
    %% for C1
    %% id ok-c1-3
    IF-->>AN: OK
    %% pass antenna2 C1
    %% after 0 ok-c1-3
    %% move C2L to antenna2
    %% after 0 ok-c1-3
    %% move C3 to antenna2
    %% after 0.2 antenna2 C3
    %% caption 6 · Clear | The interface expects the second sample at the sampling point, but finds the third one: the second never arrived. It sends Clear for the second sample and waits for the reply.
    %% after 0.2 antenna2 C3
    %% id clear-c2
    IF->>AN: Clear SampleId=SID-000124
    %% on antenna3
    %% id release-c1
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1 clear-c2
    %% id ok-c2-2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.1 release-c1
    %% for C1
    AN-->>IF: OK
    %% after 0 ok-c2-2
    %% hide C2L duration=0.6
    %% after 0.3 ok-c2-2
    %% caption 7 · Sample Acquisition — Release | Only after the reply to Clear the interface sends Sample Acquisition for the third sample. Meanwhile the first carrier leaves the module: Release.
    %% after 0.2 ok-c2-2
    IF->>AN: Sample Acquisition SampleId=SID-000125
    %% after 0.1
    %% for C3
    AN-->>IF: OK
    %% after 0.1
    %% pipette antenna2 duration=4.5 sid=SID-000125
    %% after 0.2
    %% caption 8 · Back to normal | Sample Complete for the third sample: the carrier is released and, once it has left the module, the interface sends Release.
    %% after 0.2 pipette antenna2
    AN->>IF: Sample Complete SampleId=SID-000125
    %% after 0.1
    %% for C3
    IF-->>AN: OK
    %% pass antenna2 C3
    %% on antenna3
    IF->>AN: Release SampleId=SID-000125
    %% after 0.1
    %% for C3
    %% id ok-c3
    AN-->>IF: OK
    %% after 0.5
    %% caption 9 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 ok-c3
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000125
