%% # Scene 01 — single carrier with tube, happy path
%% # Prepare -> Sample Acquisition -> Sample Complete -> Release
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% geometry sampling
%% subtitle Single carrier with sample tube — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123

    %% caption 1 · Main-Lane | A carrier holding a sample tube travels along the Main-Lane towards the analyzer interface.
    %% at 2.2
    %% move C1 to antenna2
    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare — Sample Acquisition | The carrier is diverted into the Pit-Lane without stopping and the interface sends Prepare. The gate stops it on the sampling point: the interface sends Sample Acquisition, the tube can be aspirated.
    %% on antenna1
    IF->>AN: Add Tube SampleId=SID-000123
    %% after 0.1
    %% id ok-c1
    AN-->>IF: OK SampleId=SID-000123
    %% on antenna2
    %% id sample-acquisition-c1
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.1 ok-c1
    %% id query-c1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.1 sample-acquisition-c1
    %% for C1
    %% id ok-c1-2
    AN-->>IF: OK
    %% after 0.1 query-c1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 ok-c1-2
    %% caption 3 · Test query — Pipetting | After the reply to Prepare the analyzer has asked DMX (LIS) which tests to perform. Now it aspirates the biological material from the tube, while the gate holds the carrier at the sampling point.
    %% after 0.1 ok-c1-2
    %% pipette sp duration=4.5 sid=SID-000123
    %% after 0.3
    %% caption 4 · Sample Complete | When aspiration is finished the analyzer sends Sample Complete. Only after receiving it does the interface release the carrier.
    %% after 0.3 pipette sp
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1
    %% for C1
    %% id ok-c1-3
    IF-->>AN: OK
    %% after 0.1
    %% caption 5 · Carrier released — Release | The interface opens the gate and the carrier leaves the sampling point. Before it reaches the Main-Lane the interface sends Release: the sample has left the analyzer interface.
    %% after 0.1 ok-c1-3
    %% pass antenna2 C1
    %% on antenna3
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1
    %% for C1
    AN-->>IF: OK
    %% after 0.5
    %% caption 6 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.3
    %% duration 1.5
    Note over AN: Analysis
    AN->>DMX: Results SampleId=SID-000123
