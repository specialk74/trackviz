%% # Scene 13 — spur with one analyzer and two needles, happy path
%% # C1 needs both needles, C2 only needle 2: Prepare at the NSD, Prepare again at each
%% # divert that diverts it, one Sample Acquisition per needle with the Needle parameter.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with one analyzer and two sampling points — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123 route=main_in,pit1,pit2,gone
    %% carrier id=C2 sid=SID-000124 route=spawn,pit2,gone color=#0EA5E9

    %% at 2.5
    %% move C1 to d1
    %% at 2.89
    %% move C2 to d1

    %% on antenna1 C1
    IF->>AN: EAC^U07<br/>ECD-2: Prepare, ECD-5: 0<br/>SAC-3: SID-000123
    %% after 0.2 antenna1 C1
    AN->>DMX: Query Order SID-000123<br/>QBP^Q11<br/>QPD-3: SID-000123
    %% after 0.4 antenna1 C2
    DMX-->>AN: TestX and TestY for SID-000123<br/>OML^O33<br/>SAC-3: SID-000123<br/>OBR-4: TestX<br/>OBR-4: TestY
    %% after 0.6 antenna1 C2
    AN-->>IF: EAR^U08<br/>ECD-2: Prepare<br/>SAC-3: SID-000123<br/>ECR-3: 1^2


    %% on antenna1 C2
    IF->>AN: EAC^U07<br/>ECD-2: Prepare, ECD-5: 0<br/>SAC-3: SID-000124
    %% after 0.2 antenna1 C2
    AN->>DMX: Query Order SID-000124<br/>QBP^Q11<br/>QPD-3: SID-000124
    %% after 0.4 antenna1 C2
    DMX-->>AN: TestX and TestY for SID-000124<br/>OML^O33<br/>SAC-3: SID-000124br/>OBR-4: TestX<br/>OBR-4: TestY
    %% after 0.6 antenna1 C2
    AN-->>IF: EAR^U08<br/>ECD-2: Prepare<br/>SAC-3: SID-000124<br/>ECR-3: 1^2


    %% on antenna2 C1
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: Prepare, ECD-5: 1<br/>SAC-3: SID-000123
    %% on antenna2 C1 after 0.2
    AN-->>IF: EAR^U08<br/>ECD-2: Prepare<br/>SAC-3: SID-000123<br/>ECR-3: 1
    %% after 0.1
    %% pass div1

    %% on antenna2 C2
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: Prepare, ECD-5: 1<br/>SAC-3: SID-000124
    %% after 0.2 antenna2 C2
    AN-->>IF: EAR^U08<br/>ECD-2: Prepare<br/>SAC-3: SID-000124<br/>ECR-3: 1
    %% after 0.1
    %% pass div1

    

    %% caption 1 · One analyzer, two sampling points | The spur serves one analyzer with two needles, each on its own pit-lane. Which needles a sample needs depends on its tests: one of them, or both.
    %% on antenna2 C1
    %% caption 2 · Standard divert — Prepare again | Each carrier is diverted into the spur without stopping (Prepare), then stops at the divert and is read. The first needs needle 1: Prepare again and diverted. The second only needs needle 2: straight on.
