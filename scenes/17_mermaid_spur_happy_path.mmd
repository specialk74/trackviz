%% # Scene 17, written in Mermaid: trackviz scenes/17_mermaid_spur_happy_path.mmd
%% # The %% comments describe the physical side and don't appear in the diagram.
%% # Every step starts when the one before it ends, unless a directive before it
%% # says otherwise: "on antennaN" when its carrier is over that antenna, "after N"
%% # N seconds after the step before, "after N <message> <carrier>" N seconds after
%% # that message has arrived, "at N" at second N of the video.
%% include common/spur_one_carrier.mmd
%% subtitle Spur — happy path, written in Mermaid
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare | The carrier is diverted without stopping: Prepare.
    %% on antenna1 C1
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    AN-->>IF: OK SampleId=SID-000123
    AN->>DMX: Query SampleId=SID-000123
    DMX-->>AN: Tests to perform SampleId=SID-000123

    %% on antenna2 C1
    %% caption 3 · Sample Acquisition | The carrier stops at the sampling point.
    %% on antenna2
    IF->>AN: Sample Acquisition SampleId=SID-000123
    AN-->>IF: OK
    %% pipette sp duration=4
    AN->>IF: Sample Complete SampleId=SID-000123
    IF-->>AN: OK

    %% move C1 to iface_out ease=in
    %% on antenna3 C1
    %% caption 4 · Release | The carrier leaves the module: Release.
    %% on antenna3
    IF->>AN: Release SampleId=SID-000123
    AN-->>IF: OK
    AN->>DMX: Results SampleId=SID-000123
