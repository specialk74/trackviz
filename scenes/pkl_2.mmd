%% # Scene 13 — spur with one analyzer and two needles, happy path
%% # C1 needs both needles, C2 only needle 2: Prepare at the NSD, Prepare again at each
%% # divert that diverts it, one Sample Acquisition per needle with the Needle parameter.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with one analyzer and two sampling points — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123
    %% carrier id=C2 sid=SID-000124 color=#0EA5E9
    %% carrier id=C3 sid=SID-000125 color=#9333EA
    %% carrier id=C2L sid=SID-000124 start=antenna3 color=#0EA5E9 ghost hidden tag=SID-000124_(expected)
    %% @video message=0.5

    %% at 1.5
    %% move C1 to antenna2
    %% at 1.8
    %% move C2 to antenna2
    %% at 2.1
    %% move C3 to antenna2

    %% on antenna2 C1
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000123
    AN->>DMX: Query Order SID-000123<br/>QBP^Q11<br/>QPD-3: SID-000123
    DMX->>AN: OML^O33<br/>SAC-3: SID-000123<br/>OBR-4: TestX<br/>OBR-4: TestY
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000123<br/>ECR-1: OK, ECR-3: 1^2
    %% pass antenna2 C1

    %% on antenna2 C2
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000124
    AN->>DMX: Query Order SID-000124<br/>QBP^Q11<br/>QPD-3: SID-000124
    DMX->>AN: OML^O33<br/>SAC-3: SID-000124br/>OBR-4: TestX<br/>OBR-4: TestY
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000124<br/>ECR-1: OK, ECR-3: 1^2
    %% pass antenna2 C2

    %% on antenna2 C3
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000125
    AN->>DMX: Query Order SID-000125<br/>QBP^Q11<br/>QPD-3: SID-000125
    DMX->>AN: OML^O33<br/>SAC-3: SID-000125br/>OBR-4: TestX
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000125<br/>ECR-1: OK, ECR-3: 1
    %% pass antenna2 C3

    %% on antenna3 C1
    %% color #9333EA
    %% id eac-u07-c1
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000123
    %% on antenna3 C1
    %% caption 2 · Standard divert — Prepare again | Each carrier is diverted into the spur without stopping (Prepare), then stops at the divert and is read. The first needs needle 1: Prepare again and diverted. The second only needs needle 2: straight on.
    %% after 0 eac-u07-c1
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000123<br/>ECR-1: OK
    %% divert antenna3 C1

    %% on antenna3 C2
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000124
    %% id ear-u08-c2
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000124<br/>ECR-1: OK

    %% on antenna3 C3
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000125
    %% id eac-u07-c3-3
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000125<br/>ECR-1: OK

    %% on antenna4 C1
    %% id eac-u07-c1-2
    IF->>AN: EAC^U07<br/>ECD-2: SA, ECD-5: 1<br/>SAC-3: SID-000123

    %% after 0 ear-u08-c2
    %% pass antenna3 C2 duration=15

    %% id show-c2l
    %% show C2L duration=0.4

    %% after 0 eac-u07-c1-2
    %% id pipette-antenna4
    %% pipette antenna4 duration=2.5 sid=SID-000123

    %% after 0 show-c2l
    %% divert antenna3 C2L

    %% after 0 eac-u07-c3-3
    %% divert antenna3 C3

    %% on antenna4 C3
    IF->>AN: EAC^U07<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000125
    AN->>IF: EAR^U08<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000125<br/>ECR-1: OK
    %% hide C2L
    IF->>AN: EAC^U07<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000125
    %% pipette antenna4 duration=5.5 sid=SID-000125
    AN->>IF: EAR^U08<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000125<br/>ECR-1: OK
    %% pass antenna4 C3

    %% on antenna5 C2
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 2<br/>SAC-3: SID-000124
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 2<br/>SAC-3: SID-000124<br/>ECR-1: OK
    %% divert antenna5 C2

    %% on antenna5 C3
    %% pass antenna5 C3
    
    %% on antenna6 C2
    IF->>AN: EAC^U07<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000124
    %% id pipette-antenna6
    %% pipette antenna6 duration=5.5 sid=SID-000124
    AN->>IF: EAR^U08<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000124<br/>ECR-1: OK
    %% pass antenna6 C2

    
    %% after 0 pipette-antenna4
    AN->>IF: EAR^U08<br/>ECD-2: SA, ECD-5: 1<br/>SAC-3: SID-000123<br/>ECR-1: OK
    %% pass antenna4 C1

    %% on antenna5 C1
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 2<br/>SAC-3: SID-000123
    %% id ear-u08-c1
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 2<br/>SAC-3: SID-000123<br/>ECR-1: OK
    
    %% after 0 ear-u08-c1
    %% divert antenna5 C1
    
    
    %% on antenna6 C1
    IF->>AN: EAC^U07<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000123
    %% pipette antenna6 duration=5.5 sid=SID-000123
    AN->>IF: EAR^U08<br/>ECD-2: SA, ECD-5: 2<br/>SAC-3: SID-000123<br/>ECR-1: OK
    %% pass antenna6 C1

    %% on antenna7 C1
    IF->>AN: EAC^U07<br/>ECD-2: RL<br/>SAC-3: SID-000123
    AN->>IF: EAR^U08<br/>ECD-2: RL<br/>SAC-3: SID-000123<br/>ECR-1: Ok
    %% pass antenna7 C1

    %% on antenna7 C2
    IF->>AN: EAC^U07<br/>ECD-2: RL<br/>SAC-3: SID-000124
    AN->>IF: EAR^U08<br/>ECD-2: RL<br/>SAC-3: SID-000124<br/>ECR-1: Ok
    %% pass antenna7 C2

    %% on antenna7 C3
    IF->>AN: EAC^U07<br/>ECD-2: RL<br/>SAC-3: SID-000125
    AN->>IF: EAR^U08<br/>ECD-2: RL<br/>SAC-3: SID-000125<br/>ECR-1: Ok
    %% pass antenna7 C3


    %% caption 1 · One analyzer, two sampling points | The spur serves one analyzer with two needles, each on its own pit-lane. Which needles a sample needs depends on its tests: one of them, or both.
