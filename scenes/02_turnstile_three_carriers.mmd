%% # Scene 02 — turnstile with gate and antenna, three carriers with tubes, happy path
%% # The Pit-Lane ends in a turnstile: a wheel with three pockets (120° apart).
%% # Positions: entry (right, at Pit-Lane height), under the analyzer needle (top),
%% # exit (left, at Pit-Lane height). Each rotation moves entry -> needle -> exit.
%% # In front of the wheel there are an antenna and a gate: every carrier stops at
%% # the antenna (Prepare is sent again). It enters the wheel only if nothing is
%% # being sampled under the needle; otherwise it waits for Sample Complete. The
%% # wheel rotates only after the waiting carrier has entered.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry turnstile
%% subtitle Turnstile with gate and antenna, three carriers holding sample tubes — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone color=#0EA5E9
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone color=#DB2777

    %% caption 1 · Turnstile with gate and antenna | The Pit-Lane ends in a turnstile, a wheel with three positions: entry, under the analyzer needle, exit. In front of it, an antenna and a gate: every carrier stops there first.
    %% at 2.6
    %% move C1 to pit_wait

    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare — antenna | The first carrier is diverted into the Pit-Lane without stopping: Prepare. The gate stops it on the antenna, which reads it: the interface sends Prepare again. Nothing is being sampled, so the gate will open.
    %% on antenna1 C1
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.5 antenna2 C1
    %% highlight antenna2 duration=1.5
    %% after 0.5 antenna2 C1
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1 OK C1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.1 Prepare C1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 Query C1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 OK C1
    %% move C1 to ts.in

    %% at 8.4
    %% move C2 to pit_wait
    %% after 0.972 OK C1
    %% caption 3 · Rotation — Sample Acquisition | With the carrier in the entry position the wheel rotates it under the needle: Sample Acquisition and aspiration. Meanwhile the second carrier is diverted, read at the antenna and held by the gate.
    %% rotate ts
    %% on antenna1 C2
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.1
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.5 antenna2 C2
    %% highlight antenna2 duration=1.5
    %% after 0.5 antenna2 C2
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.25 rotate ts
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.1 OK C2
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 Prepare C2
    %% for C2
    AN-->>IF: OK
    %% after 0.1 Sample Acquisition C1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 Query C2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1 OK C1
    %% pipette ts duration=5

    %% after 0.3
    %% caption 4 · Sample Complete — the waiting carrier enters | Sampling is finished: Sample Complete. Before the wheel rotates, the gate opens and the waiting carrier enters the entry position.
    %% after 0.3 pipette ts
    AN->>IF: Sample Complete SampleId=SID-000123
    %% at 20.3
    %% move C3 to pit_wait
    %% on antenna1 C3
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 Sample Complete C1
    %% for C1
    IF-->>AN: OK
    %% after 0.1 Prepare C3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 OK C1
    %% move C2 to ts.in
    %% after 0.5 antenna2 C3
    %% highlight antenna2 duration=1.5
    %% after 0.5 antenna2 C3
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.972 OK C1
    %% caption 5 · Rotation — Sample Acquisition | Now the wheel rotates: the new carrier goes under the needle, the processed one to the exit and back to the Main-Lane (Release once it has left). The third carrier is diverted, read at the antenna and held by the closed gate.
    %% rotate ts
    %% after 0.1 OK C3
    AN->>DMX: Query SampleId=SID-000125
    %% after 0.1 Prepare C3
    %% for C3
    AN-->>IF: OK
    %% after 0.1 rotate ts
    %% move C1 to gone
    %% after 0.1 Query C3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.25 rotate ts
    IF->>AN: Sample Acquisition SampleId=SID-000124
    %% after 0.1
    %% for C2
    AN-->>IF: OK
    %% on antenna3
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1 OK C2
    %% pipette ts duration=4.5
    %% after 0.1 Release C1
    %% for C1
    AN-->>IF: OK

    %% after 0.3 pipette ts
    %% caption 6 · Sample Complete — enter — rotate | Sample Complete for the second sample. The third carrier enters the wheel, then the wheel rotates: the third sample under the needle, the second one to the exit.
    %% after 0.3 pipette ts
    AN->>IF: Sample Complete SampleId=SID-000124
    %% after 0.1
    %% for C2
    IF-->>AN: OK
    %% after 0.1
    %% move C3 to ts.in
    %% after 0.15
    %% rotate ts
    %% after 0.1
    %% move C2 to gone
    %% after 0.25 rotate ts
    IF->>AN: Sample Acquisition SampleId=SID-000125
    %% after 0.1
    %% for C3
    AN-->>IF: OK
    %% on antenna3
    IF->>AN: Release SampleId=SID-000124
    %% after 0.1 OK C3
    %% pipette ts duration=4.5
    %% after 0.1 Release C2
    %% for C2
    AN-->>IF: OK

    %% after 0.3 pipette ts
    %% caption 7 · Last carrier | Sample Complete for the third sample. No carrier is waiting at the gate: the wheel rotates the third carrier to the exit and it leaves the module (Release).
    %% after 0.3 pipette ts
    AN->>IF: Sample Complete SampleId=SID-000125
    %% after 0.1
    %% for C3
    IF-->>AN: OK
    %% after 0.1
    %% rotate ts
    %% after 0.1
    %% move C3 to gone
    %% on antenna3
    IF->>AN: Release SampleId=SID-000125
    %% after 0.1
    %% for C3
    AN-->>IF: OK

    %% after 1
    %% caption 8 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.3
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000124
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000125
