%% # Scene 02 — turnstile with gate and antenna, three carriers with tubes, happy path
%% # The Pit-Lane ends in a turnstile: a wheel with three pockets (120° apart).
%% # Positions: entry (right, at Pit-Lane height), under the analyzer needle (top),
%% # exit (left, at Pit-Lane height). Each rotation moves entry -> needle -> exit.
%% # In front of the wheel there are an antenna and a gate: every carrier stops at
%% # the antenna (Prepare is sent again). It enters the wheel only if nothing is
%% # being sampled under the needle; otherwise it waits for Sample Complete. The
%% # wheel rotates only after the waiting carrier has entered.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry turnstile
%% subtitle Turnstile with gate and antenna, three carriers holding sample tubes — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75 color=#0EA5E9
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75 color=#DB2777

    %% at 0
    %% caption 1 · Turnstile with gate and antenna | The Pit-Lane ends in a turnstile, a wheel with three positions: entry, under the analyzer needle, exit. In front of it, an antenna and a gate: every carrier stops there first.
    %% at 2.26
    %% move C1 to nsd ease=in
    %% when C1 at nsd
    %% move C1 to pit_wait ease=out
    %% when C1 at nsd
    %% caption 2 · Diverted — Prepare | The first carrier is diverted into the Pit-Lane without stopping, and the interface sends Prepare to the analyzer.
    %% when C1 at nsd
    %% highlight nsd duration=2
    %% when C1 at nsd
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare C1 sent
    %% delay 1.997
    AN-->>IF: OK SampleId=SID-000123
    %% when sample_ok C1 arrived
    %% delay 0.3
    AN->>DMX: Query SampleId=SID-000123
    %% at 9.96
    %% move C2 to nsd ease=in
    %% when C1 at pit_wait
    %% caption 3 · Antenna — Prepare again | The carrier stops at the antenna in front of the gate: it is read and the interface sends Prepare again (later with an extra piece of information). Nothing is being sampled, so the gate opens.
    %% when C1 at pit_wait
    %% highlight antenna2 duration=1.5
    %% when C1 at pit_wait
    %% delay 0.2
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare_again C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when query C1 sent
    %% delay 2.53
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% when C1 at pit_wait
    %% delay 1.777
    %% move C1 to ts.in ease=inout duration=2
    %% when C1 at ts.in
    %% caption 4 · Rotation | Only now, with the carrier in the entry position, the wheel rotates and brings it under the needle. Meanwhile the second carrier is diverted: Prepare.
    %% when C1 at ts.in
    %% delay 0.15
    %% rotate ts
    %% when C2 at nsd
    %% move C2 to pit_wait ease=out
    %% when C2 at nsd
    %% highlight nsd duration=2
    %% when C2 at nsd
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare C2 sent
    %% delay 1.732
    AN-->>IF: OK SampleId=SID-000124
    %% when rotate ts done
    %% delay 0.05
    %% caption 5 · Sample Acquisition — the next carrier waits | Under the needle: Sample Acquisition, then the analyzer aspirates. The second carrier is read at the antenna (Prepare again), but the gate stays closed while a sample is processed.
    %% when rotate ts done
    %% delay 0.25
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when analyzer_ok C1 arrived
    %% delay 0.1
    %% pipette ts duration=5
    %% when sample_ok C2 arrived
    %% delay 0.8
    AN->>DMX: Query SampleId=SID-000124
    %% when C2 at pit_wait
    %% delay 0.032
    %% highlight antenna2 duration=1.5
    %% when C2 at pit_wait
    %% delay 0.18
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare_again C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when query C2 sent
    %% delay 2.3
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% at 23.46
    %% move C3 to nsd ease=in
    %% when pipette ts done
    %% delay 0.2
    %% caption 6 · Sample Complete — the waiting carrier enters | Sampling is finished: Sample Complete. Before the wheel rotates, the gate opens and the waiting carrier enters the entry position.
    %% when pipette ts done
    %% delay 0.3
    AN->>IF: Sample Complete SampleId=SID-000123
    %% when sample_complete C1 arrived
    %% delay 0.1
    %% for C1
    IF-->>AN: OK
    %% when interface_ok C1 sent
    %% delay 0.1
    %% move C2 to ts.in ease=inout duration=2
    %% when C2 at ts.in
    %% delay 0.1
    %% caption 7 · Rotation — Sample Acquisition | Now the wheel rotates: the new carrier goes under the needle, the processed one to the exit and back to the Main-Lane. The third carrier is diverted.
    %% when C2 at ts.in
    %% delay 0.1
    %% rotate ts
    %% when C3 at nsd
    %% move C3 to pit_wait ease=out
    %% when C3 at nsd
    %% highlight nsd duration=2
    %% when C3 at nsd
    IF->>AN: Prepare SampleId=SID-000125
    %% when rotate ts done
    %% delay 0.2
    %% move C1 to merge ease=in
    %% when rotate ts done
    %% delay 0.4
    IF->>AN: Sample Acquisition SampleId=SID-000124
    %% when sample_acquisition C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when prepare C3 sent
    %% delay 2.032
    AN-->>IF: OK SampleId=SID-000125
    %% when analyzer_ok C2 arrived
    %% delay 0.1
    %% pipette ts duration=4.5
    %% when sample_ok C3 arrived
    %% delay 0.4
    AN->>DMX: Query SampleId=SID-000125
    %% when C3 at pit_wait
    %% delay 0.032
    %% caption 8 · The third carrier waits at the gate | The third carrier is read at the antenna (Prepare again) and waits at the closed gate while the second sample is aspirated.
    %% when C3 at pit_wait
    %% delay 0.032
    %% highlight antenna2 duration=1.5
    %% when C3 at pit_wait
    %% delay 0.18
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000125
    %% when prepare_again C3 arrived
    %% delay 0.1
    %% for C3
    AN-->>IF: OK
    %% when query C3 sent
    %% delay 2.4
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% when pipette ts done
    %% delay 0.2
    %% caption 9 · Sample Complete — Release — enter — rotate | Sample Complete for the second sample, Release for the first carrier once it has left the module. The third carrier enters the wheel, then the wheel rotates.
    %% when pipette ts done
    %% delay 0.3
    AN->>IF: Sample Complete SampleId=SID-000124
    %% when sample_complete C2 arrived
    %% delay 0.1
    %% for C2
    IF-->>AN: OK
    %% when C1 at merge
    %% delay 0.005
    %% move C1 to gone ease=out
    %% when C1 at main_out
    IF->>AN: Release SampleId=SID-000123
    %% when release C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when interface_ok C2 sent
    %% delay 0.1
    %% move C3 to ts.in ease=inout duration=2
    %% when C3 at ts.in
    %% delay 0.1
    %% rotate ts
    %% when rotate ts done
    %% delay 0.2
    %% move C2 to merge ease=in
    %% when rotate ts done
    %% delay 0.4
    IF->>AN: Sample Acquisition SampleId=SID-000125
    %% when sample_acquisition C3 arrived
    %% delay 0.1
    %% for C3
    AN-->>IF: OK
    %% when analyzer_ok C3 arrived
    %% delay 0.1
    %% pipette ts duration=4.5
    %% when pipette ts done
    %% delay 0.2
    %% caption 10 · Last carrier | Sample Complete for the third sample. No carrier is waiting at the gate: the wheel rotates the third carrier to the exit and it leaves the module (Release).
    %% when pipette ts done
    %% delay 0.3
    AN->>IF: Sample Complete SampleId=SID-000125
    %% when sample_complete C3 arrived
    %% delay 0.1
    %% for C3
    IF-->>AN: OK
    %% when C2 at merge
    %% delay 0.005
    %% move C2 to gone ease=out
    %% when C2 at main_out
    IF->>AN: Release SampleId=SID-000124
    %% when release C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when interface_ok C3 sent
    %% delay 0.1
    %% rotate ts
    %% when rotate ts done
    %% delay 0.2
    %% move C3 to merge ease=in
    %% when C3 at merge
    %% move C3 to gone ease=out
    %% when C3 at main_out
    IF->>AN: Release SampleId=SID-000125
    %% when release C3 arrived
    %% delay 0.1
    %% for C3
    AN-->>IF: OK
    %% when analyzer_ok C3 arrived
    %% delay 0.5
    %% caption 11 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% when analyzer_ok C3 arrived
    %% delay 0.5
    AN->>DMX: Results SampleId=SID-000123
    %% when results C1 arrived
    %% delay 0.2
    AN->>DMX: Results SampleId=SID-000124
    %% when results C2 arrived
    %% delay 0.2
    AN->>DMX: Results SampleId=SID-000125
