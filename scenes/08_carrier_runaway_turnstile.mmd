%% # Scene 08 — carrier run-away during sampling (turnstile)
%% # Same situation as scene 07 with the turnstile, gate and antenna of scene 02.
%% # After Sample Acquisition for the first carrier, before the needle goes down,
%% # the wheel turns by itself: the first carrier goes to the exit and runs away
%% # to the Main-Lane. The needle goes down into an empty pocket, but the analyzer
%% # sends Sample Complete for the first sample. The interface sends Cancel, sends
%% # the waiting carriers away through the wheel (no sampling) and, right after
%% # the reply to Cancel, sends Clear All.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry turnstile_queue
%% subtitle Three carriers — carrier run-away during sampling, Cancel and Clear All (turnstile)
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,pit_q,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,pit_q,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75 color=#0EA5E9
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,pit_q,pit_wait,ts.in,ts.out,pit_out,merge,main_out,gone speed=75 color=#DB2777

    %% at 0
    %% caption 1 · Three carriers | Three carriers holding sample tubes are diverted into the Pit-Lane, one after the other: for each one the interface sends Prepare and the analyzer asks DMX which tests to perform.
    %% at 2.26
    %% move C1 to nsd ease=in
    %% when C1 at nsd
    %% move C1 to pit_wait ease=out
    %% when C1 at nsd
    %% highlight nsd duration=2
    %% when C1 at nsd
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare C1 sent
    %% delay 1.597
    AN-->>IF: OK SampleId=SID-000123
    %% at 7.07
    %% move C2 to nsd ease=linear
    %% when sample_ok C1 arrived
    %% delay 0.7
    AN->>DMX: Query SampleId=SID-000123
    %% when C2 at nsd
    %% move C2 to pit_wait ease=out
    %% when C2 at nsd
    %% highlight nsd duration=2
    %% when C2 at nsd
    IF->>AN: Prepare SampleId=SID-000124
    %% at 10.07
    %% move C3 to nsd ease=linear
    %% when C1 at pit_wait
    %% highlight antenna duration=1.5
    %% when C1 at pit_wait
    %% delay 0.2
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare_again C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when query C1 sent
    %% delay 2.53
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% when prepare C2 sent
    %% delay 1.597
    AN-->>IF: OK SampleId=SID-000124
    %% when C1 at pit_wait
    %% delay 1.777
    %% move C1 to ts.in ease=inout duration=2
    %% when sample_ok C2 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000124
    %% when C3 at nsd
    %% move C3 to pit_q ease=out
    %% when C3 at nsd
    %% highlight nsd duration=2
    %% when C3 at nsd
    IF->>AN: Prepare SampleId=SID-000125
    %% when query C2 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% when C1 at ts.in
    %% delay 0.15
    %% rotate ts
    %% when prepare C3 sent
    %% delay 1.597
    AN-->>IF: OK SampleId=SID-000125
    %% when C2 at pit_wait
    %% highlight antenna duration=1.5
    %% when tests C2 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000125
    %% when C2 at pit_wait
    %% delay 0.2
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare_again C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when rotate ts done
    %% delay 0.05
    %% caption 2 · Sample Acquisition | The first carrier is under the needle: Sample Acquisition. The second one waits at the closed gate, the third one behind it.
    %% when rotate ts done
    %% delay 0.25
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when query C3 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% caption 3 · Carrier run-away | Before the needle goes down, the wheel turns by itself: the first carrier goes to the exit and runs away. The interface notices it and turns red. The needle is over an empty pocket.
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% highlight ts duration=2
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% rotate ts
    %% when sample_acquisition C1 arrived
    %% delay 0.1
    %% status interface error
    %% when rotate ts done
    %% delay 0.1
    %% move C1 to gone ease=linear speed=120 runaway
    %% when rotate ts done
    %% delay 1.2
    %% caption 4 · Nothing is aspirated | The analyzer pipettes the empty pocket: there is no tube under the needle, but it believes it is sampling the first sample.
    %% when analyzer_ok C1 arrived
    %% delay 0.1
    %% pipette ts duration=4.5
    %% when pipette ts done
    %% delay 0.2
    %% caption 5 · Sample Complete — Cancel | The analyzer sends Sample Complete for the first sample. The interface knows the first carrier is gone: it sends Cancel for the first sample, and the analyzer replies OK.
    %% when pipette ts done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000123
    %% when sample_complete C1 arrived
    %% delay 0.1
    %% for C1
    IF-->>AN: OK
    %% when sample_complete C1 arrived
    %% delay 0.2
    IF->>AN: Cancel SampleId=SID-000123
    %% when cancel C1 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000123
    %% when sample_ok C1 arrived
    %% delay 0.1
    IF->>AN: Clear All
    %% when sample_ok C1 arrived
    %% delay 0.2
    %% caption 6 · All carriers sent away — Clear All | Right after the reply to Cancel the interface sends Clear All, which cancels every Prepare, and sends every carrier away through the wheel, without sampling. Once they have left the interface, it turns grey again.
    %% when sample_ok C1 arrived
    %% delay 0.2
    %% move C2 to ts.in ease=inout duration=2
    %% when clear_all sent
    %% delay 1.37
    %% status interface normal
    %% when clear_all sent
    %% delay 1.7
    AN-->>IF: OK
    %% when C2 at ts.in
    %% delay 0.15
    %% rotate ts
    %% when sample_ok C1 arrived
    %% delay 2.4
    %% move C3 to pit_wait ease=inout duration=1.2
    %% when rotate ts done
    %% delay 0.15
    %% move C3 to ts.in ease=inout duration=2
    %% when C3 at ts.in
    %% delay 0.15
    %% rotate ts
    %% when rotate ts done
    %% delay 0.15
    %% move C2 to merge ease=in
    %% when rotate ts done
    %% delay 2.95
    %% rotate ts
    %% when rotate ts done
    %% delay 0.2
    %% move C3 to merge ease=in
    %% when C2 at merge
    %% move C2 to gone ease=out
    %% when C3 at merge
    %% move C3 to gone ease=out
