%% # Scene 08 — carrier run-away during sampling (turnstile)
%% # Same situation as scene 07 with the turnstile, gate and antenna of scene 02.
%% # After Sample Acquisition for the first carrier, before the needle goes down,
%% # the wheel turns by itself: the first carrier goes to the exit and runs away
%% # to the Main-Lane. The needle goes down into an empty pocket, but the analyzer
%% # sends Sample Complete for the first sample. The interface sends Cancel, sends
%% # the waiting carriers away through the wheel (no sampling) and, right after
%% # the reply to Cancel, sends Clear All.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry turnstile_queue
%% subtitle Three carriers — carrier run-away during sampling, Cancel and Clear All (turnstile)
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123
    %% carrier id=C2 sid=SID-000124 color=#0EA5E9
    %% carrier id=C3 sid=SID-000125 color=#DB2777

    %% caption 1 · Three carriers | Three carriers holding sample tubes are diverted into the Pit-Lane, one after the other: for each one the interface sends Prepare and the analyzer asks DMX which tests to perform.
    %% at 2.26
    %% move C1 to antenna2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.097
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.2 antenna2 C1
    %% color #9333EA
    %% id prepare-c1
    IF->>AN: Prepare SampleId=SID-000123
    %% at 6.97
    %% move C2 to antenna2
    %% after 3.797 antenna1 C1
    %% id query-c1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.08 prepare-c1
    %% pass antenna2 C1
    %% after 0.15
    %% rotate ts
    %% after 0.1 prepare-c1
    %% for C1
    AN-->>IF: OK
    %% on antenna1
    %% id prepare-c2
    IF->>AN: Prepare SampleId=SID-000124
    %% after 1.03 query-c1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% at 9.97
    %% move C3 to pit_q
    %% after 0.097 prepare-c2
    %% id ok-c2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.25 rotate ts
    %% id sample-acquisition-c1
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.2 antenna2 C2
    %% color #9333EA
    %% id prepare-c2-2
    IF->>AN: Prepare SampleId=SID-000124
    %% on antenna1
    %% id prepare-c3
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 ok-c2
    %% id query-c2
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 sample-acquisition-c1
    %% for C1
    %% id ok-c1
    AN-->>IF: OK
    %% after 0.1 sample-acquisition-c1
    %% caption 2 · Sample Acquisition — carrier run-away | Sample Acquisition for the first carrier. Before the needle goes down the wheel turns by itself: the carrier goes to the exit and runs away. The interface turns red.
    %% after 0.1 sample-acquisition-c1
    %% highlight ts duration=2
    %% after 0.1 sample-acquisition-c1
    %% rotate ts
    %% after 0.1 sample-acquisition-c1
    %% status interface error
    %% after 0.1 prepare-c2-2
    %% for C2
    AN-->>IF: OK
    %% after 0.097 prepare-c3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.2 query-c2
    %% id tests-to-perform-c2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1 ok-c1
    %% pipette antenna3 duration=4.5 sid=SID-000123
    %% after 0.1 rotate ts
    %% move C1 to gone runaway
    %% after 0.1 tests-to-perform-c2
    %% id query-c3
    AN->>DMX: Query SampleId=SID-000125
    %% after 1.2 rotate ts
    %% caption 3 · Nothing is aspirated | The analyzer pipettes the empty pocket: there is no tube under the needle, but it believes it is sampling the first sample.
    %% after 0.2 query-c3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.2 pipette antenna3
    %% caption 4 · Sample Complete — Cancel | The analyzer sends Sample Complete for the first sample. The interface knows the first carrier is gone: it sends Cancel for the first sample, and the analyzer replies OK.
    %% after 0.2 pipette antenna3
    %% id sample-complete-c1
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1
    %% for C1
    IF-->>AN: OK
    %% after 0.2 sample-complete-c1
    IF->>AN: Cancel SampleId=SID-000123
    %% after 0.2
    %% id ok-c1-2
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.1
    %% id clear-all
    IF->>AN: Clear All
    %% after 0.2 ok-c1-2
    %% caption 5 · All carriers sent away — Clear All | Right after the reply to Cancel the interface sends Clear All, which cancels every Prepare, and sends every carrier away through the wheel, without sampling. Once they have left the interface, it turns grey again.
    %% after 0.2 ok-c1-2
    %% move C3 to antenna2
    %% after 0.2 ok-c1-2
    %% pass antenna2 C2
    %% after 0.15
    %% rotate ts
    %% after 0.2 clear-all
    AN-->>IF: OK
    %% after 0.15 rotate ts
    %% pass antenna2 C3
    %% after 0.15
    %% rotate ts
    %% after 0.15
    %% move C2 to gone
    %% after 0.15 rotate ts
    %% rotate ts
    %% after 0.2
    %% move C3 to gone
    %% on antenna4 C3
    %% status interface normal
