%% # Scene 14 — spur with two needles, a carrier expected in the spur is missing: Clear
%% # C2 goes straight on the Main-Lane; its logical position is a dashed ghost (C2L). When the
%% # first divert reads C3 instead of C2 the interface sends Clear for C2 and, after the
%% # reply, Prepare again for C3.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with two sampling points — a carrier expected in the spur is missing, Clear
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123 route=main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone
    %% # The real C2: it is not diverted.
    %% carrier id=C2 sid=SID-000124 route=spawn,main_in,nsd,merge,iface_out,main_out,gone color=#0EA5E9
    %% # Where the interface believes C2 is.
    %% carrier id=C2L sid=SID-000124 route=nsd,pit_in,w1c,w1b,spur_in,w1,d1 color=#0EA5E9 ghost hidden tag=SID-000124_(expected)
    %% carrier id=C3 sid=SID-000125 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone color=#DB2777

    %% caption 1 · Three carriers | Three carriers meant for needle 1 of the analyzer travel on the Main-Lane towards the spur.
    %% at 2.5
    %% move C1 to d1
    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare | The first carrier is diverted into the spur without stopping: the interface sends Prepare to the analyzer.
    %% on antenna1 C1
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0 Prepare C1
    %% highlight nsd duration=1.6
    %% at 4.6
    %% move C2 to gone
    %% on antenna2 C1
    %% highlight div1 duration=0.6
    %% after 0.1 antenna2 C1
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% on antenna1 C2
    AN-->>IF: OK SampleId=SID-000123
    %% on antenna1 C2
    %% caption 3 · Physically straight, logically diverted | The second carrier should be diverted too, and the interface sends Prepare. But physically it goes straight on the Main-Lane: the dashed outline is where the interface believes it is.
    %% on antenna1 C2
    %% move C2L to d1
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000124
    %% on antenna1 C2
    %% show C2L duration=0.4
    %% after 0.6 antenna2 C1
    %% pass div1
    %% after 0.1 Prepare C1
    %% for C1
    AN-->>IF: OK
    %% after 1.7 antenna1 C2
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.2 Prepare C2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.2 antenna3 C1
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=1
    %% at 7.6
    %% move C3 to d1
    %% on antenna1 C3
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.2 Query C1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 Sample Acquisition C1
    %% for C1
    AN-->>IF: OK
    %% after 0.2 Prepare C3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 Tests to perform C1
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 OK C1
    %% pipette sp1 duration=6.6 sid=SID-000123
    %% on antenna2 C3
    %% caption 4 · Read at the divert — Clear | The third carrier stops at the divert on top of the second one, which is not there. It reads the third sample instead of the second: the interface sends Clear for the second.
    %% on antenna2 C3
    %% highlight div1 duration=0.6
    %% after 0.195 antenna2 C3
    IF->>AN: Clear SampleId=SID-000124
    %% after 0.6 antenna2 C3
    %% move C3 to q1
    %% after 0.2 Query C2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1 Clear C2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.1 Tests to perform C2
    AN->>DMX: Query SampleId=SID-000125
    %% after 0 OK C2
    %% hide C2L duration=0.6
    %% after 0.1 OK C2
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.2 Query C3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0 Prepare C3
    %% caption 5 · Prepare again for the third carrier | The carrier does not wait for the reply to Clear: it is diverted right away, behind the first one. Once the reply has arrived the interface sends Prepare again for it.
    %% after 0.1 Prepare C3
    %% for C3
    AN-->>IF: OK
    %% after 0.2 pipette sp1
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=1
    %% caption 6 · Sample Complete | Sample Complete: the first carrier is released and the third moves up to the sampling point.
    %% after 0.1 Sample Complete C1
    %% for C1
    IF-->>AN: OK
    %% pass sp1
    %% after 0 OK C1
    %% move C3 to s1
    %% after 0.2 antenna3 C3
    IF->>AN: Sample Acquisition SampleId=SID-000125 Needle=1
    %% on antenna4 C1
    %% highlight div2 duration=0.6
    %% after 0.401 antenna4 C1
    %% pass div2
    %% after 0.1 Sample Acquisition C3
    %% for C3
    AN-->>IF: OK
    %% after 0.1
    %% pipette sp1 duration=4 sid=SID-000125
    %% on antenna6
    IF->>AN: Release SampleId=SID-000123
    %% after 0.2 pipette sp1
    AN->>IF: Sample Complete SampleId=SID-000125 Needle=1
    %% after 0.1 Release C1
    %% for C1
    AN-->>IF: OK
    %% after 0 Sample Complete C3
    %% caption 7 · Back to normal | Sample Complete for the third sample: the carrier goes on up the spur, stops at the second divert and, once it has left the module, gets its Release.
    %% after 0.1 Sample Complete C3
    %% for C3
    IF-->>AN: OK
    %% pass sp1
    %% on antenna4 C3
    %% highlight div2 duration=0.6
    %% after 0.401 antenna4 C3
    %% pass div2
    %% on antenna6
    IF->>AN: Release SampleId=SID-000125
    %% after 0.1
    %% for C3
    AN-->>IF: OK
    %% after 0.5
    %% caption 8 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 OK C3
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000125
