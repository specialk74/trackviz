%% # Scene 07 — carrier run-away during sampling (sampling point)
%% # Three carriers are diverted into the Pit-Lane. After Sample Acquisition for
%% # the first one, before the needle goes down, the first carrier runs away and
%% # goes back to the Main-Lane; the second slides under the needle and the
%% # analyzer aspirates it, believing it is the first. On Sample Complete (with the
%% # first SampleId) the interface sends Cancel, right after the reply sends
%% # Clear All, while the carriers are sent away.
%% # Carrier flow: right to left, Pit-Lane above the Main-Lane.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry sampling_queue2
%% subtitle Three carriers — carrier run-away during sampling, Cancel and Clear All (sampling point)
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123
    %% carrier id=C2 sid=SID-000124 color=#0EA5E9
    %% carrier id=C3 sid=SID-000125 color=#DB2777

    %% caption 1 · Three carriers | Three carriers holding sample tubes are diverted into the Pit-Lane, one after the other: for each one the interface sends Prepare and the analyzer asks DMX which tests to perform.
    %% at 2.2
    %% move C1 to antenna2
    %% at 2.6
    %% move C2 to antenna2
    %% at 3
    %% move C3 to queue
    %% on antenna1
    %% id prepare-c1
    IF->>AN: Prepare SampleId=SID-000123
    %% on antenna1
    %% id prepare-c2
    IF->>AN: Prepare SampleId=SID-000124
    %% on antenna1
    %% id prepare-c3
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 prepare-c1
    %% id ok-c1
    AN-->>IF: OK SampleId=SID-000123
    %% on antenna2 C1
    %% caption 2 · Sample Acquisition | The first carrier is at the sampling point, the other two queue up behind it. The interface sends Sample Acquisition for the first sample.
    %% on antenna2
    %% id sample-acquisition-c1
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.1 prepare-c2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.1 prepare-c3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 ok-c1
    %% id query-c1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.1 sample-acquisition-c1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 query-c1
    %% id tests-to-perform-c1
    DMX-->>AN: Tests to perform SampleId=SID-000123

    %% after 1.5 sample-acquisition-c1
    %% move C1 to gone runaway
    %% after 1.5 sample-acquisition-c1
    %% caption 3 · Carrier run-away — the wrong sample is aspirated | Before the needle goes down the first carrier runs away and the second one slides under the needle: the interface turns red. The analyzer aspirates the second sample, believing it is the first.
    %% after 1.5 sample-acquisition-c1
    %% status interface error
    %% after 0.5 antenna2 C2
    %% pipette antenna2 duration=4.5 sid=SID-000123
    %% after 0.1 tests-to-perform-c1
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1
    %% id query-c3
    AN->>DMX: Query SampleId=SID-000125

    %% after 0.3 pipette antenna2
    %% caption 4 · Sample Complete — Cancel | The analyzer sends Sample Complete for the first sample. The interface knows the first carrier is gone: it sends Cancel for the first sample, and the analyzer replies OK.
    %% after 0.3 pipette antenna2
    %% id sample-complete-c1
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1 query-c3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.1 sample-complete-c1
    %% for C1
    IF-->>AN: OK
    %% after 0.2 sample-complete-c1
    IF->>AN: Cancel SampleId=SID-000123
    %% after 0.1
    %% id ok-c1-2
    AN-->>IF: OK SampleId=SID-000123
    %% after 0.1
    %% id clear-all
    IF->>AN: Clear All
    %% after 0.2 ok-c1-2
    %% caption 5 · All carriers sent away — Clear All | Right after the reply to Cancel the interface sends Clear All, which cancels every Prepare, and sends every carrier away, without sampling. Once they have left the interface, it turns grey again.
    %% after 0.2 ok-c1-2
    %% pass antenna2 C2
    %% after 0.2 ok-c1-2
    %% move C3 to gone
    %% after 0.1 clear-all
    AN-->>IF: OK
    %% on antenna3 C3
    %% status interface normal
