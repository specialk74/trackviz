%% # Analyzer in Manual Mode on a spur with two needles.
%% # The analyzer goes into Manual Mode while C1 is on its way to needle 1 and C2 is
%% # at Divert 1: the interface turns red (warning) and stops diverting (C2 is held
%% # at Divert 1, C3 goes straight on).
%% # After the timeout it releases the carriers in the pit-lane and sends Clear for
%% # each. The analyzer leaves Manual Mode, the interface diverts again (C4); the
%% # analyzer goes back into Manual Mode for a short while before C4 reaches the
%% # sampling point, then C4 is sampled and
%% # released normally.
%% # A technician with tubes in hand walks up and puts the analyzer in Manual Mode.
%% # Manual Mode: ESU^U01 with EQU-3 MM; back to normal operation: EQU-3 OP.
%% geometry spur2
%% subtitle Spur — analyzer in Manual Mode, timeout and recovery
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier id=C1 sid=SID-000123
    %% carrier id=C2 sid=SID-000124 color=#0EA5E9
    %% carrier id=C3 sid=SID-000125 color=#9333EA
    %% carrier id=C4 sid=SID-000126 color=#16A34A
    %% @video message=0.5

    %% caption 1 · Two samples for needle 1 | Two carriers enter the spur, both for needle 1. Divert 1 sends the first one into the pit-lane of needle 1.
    %% at 1.5
    %% move C1 to antenna2
    %% at 1.8
    %% move C2 to antenna2

    %% on antenna2 C1
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000123
    AN->>DMX: QBP^Q11<br/>QPD-3: SID-000123
    DMX->>AN: OML^O33<br/>SAC-3: SID-000123<br/>OBR-4: TestX
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000123<br/>ECR-1: OK, ECR-3: 1
    %% pass antenna2 C1

    %% on antenna2 C2
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000124
    AN->>DMX: QBP^Q11<br/>QPD-3: SID-000124
    %% id oml-o33-c2
    DMX->>AN: OML^O33<br/>SAC-3: SID-000124<br/>OBR-4: TestY

    %% after 1.0 antenna2 C2
    %% operator an tubes duration=19.3
    %% after 0 oml-o33-c2
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000124<br/>ECR-1: OK, ECR-3: 1
    %% pass antenna2 C2

    %% on antenna3 C1
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000123
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000123<br/>ECR-1: OK
    %% divert antenna3 C1

    %% after 1.9 antenna3 C1
    %% caption 2 · Analyzer in Manual Mode | Before the first carrier reaches the needle, a technician with a few tubes in hand switches the analyzer to Manual Mode. The interface turns red, in warning: it does not divert any more carriers.
    %% after 1.9 antenna3 C1
    %% id manual-1
    AN->>IF: ESU^U01<br/>EQU-3: MM (Manual Mode)
    %% after 0 manual-1
    %% status an manual
    %% status interface warning
    IF->>AN: ACK^U01<br/>MSA-1: AA

    %% after 0.5 manual-1
    %% id timeout-1
    %% timer interface 300 duration=7 label=Manual_Mode_timeout

    %% after 1.5 manual-1
    %% move C3 to gone
    %% after 3.0 manual-1
    %% caption 3 · No more diverts | The second carrier is held at Divert 1, the first one waits at the sampling point without a sampling request, and a new carrier stays on the Main-Lane. Meanwhile the timeout runs.

    %% after 0.8 timeout-1
    %% caption 4 · Timeout — Release and Clear | The timeout has expired and the analyzer is still in Manual Mode: the interface releases all the carriers in the spur, at the sampling point and at Divert 1, and sends Clear for each sample.
    %% after 0.8 timeout-1
    %% pass antenna4 C1
    %% after 0.8 timeout-1
    %% id eac-u07-c1
    IF->>AN: EAC^U07<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000123
    %% after 0.8 timeout-1
    %% pass antenna3 C2
    %% after 0 eac-u07-c1
    AN->>IF: EAR^U08<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000123<br/>ECR-1: OK
    IF->>AN: EAC^U07<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000124
    %% id clear-2
    AN->>IF: EAR^U08<br/>ECD-2: CL, ECD-5: 1<br/>SAC-3: SID-000124<br/>ECR-1: OK
    %% on antenna5 C2
    %% pass antenna5 C2

    %% on antenna5 C1
    %% pass antenna5 C1

    %% after 3.0 clear-2
    %% caption 5 · Manual Mode ended | The technician has finished and walks away: the analyzer goes back to normal operation. The interface leaves the warning and starts diverting carriers again.
    %% after 3.0 clear-2
    %% id remote-1
    AN->>IF: ESU^U01<br/>EQU-3: OP (Operating)
    %% status an normal
    %% status interface normal
    IF->>AN: ACK^U01<br/>MSA-1: AA

    %% after 0.5 remote-1
    %% move C4 to antenna2
    %% on antenna2 C4
    %% caption 6 · Diverting again | The next carrier is diverted into the spur again: Prepare, test query, then Divert 1 sends it to needle 1.
    %% on antenna2 C4
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 0<br/>SAC-3: SID-000126
    %% id qbp-q11-c4
    AN->>DMX: QBP^Q11<br/>QPD-3: SID-000126
    %% on antenna7 C2
    %% pass antenna7 C2
    %% after 0 qbp-q11-c4
    DMX->>AN: OML^O33<br/>SAC-3: SID-000126<br/>OBR-4: TestX
    %% id ear-u08-c4
    AN->>IF: EAR^U08<br/>ECD-2: PR<br/>SAC-3: SID-000126<br/>ECR-1: OK, ECR-3: 1
    %% on antenna7 C1
    %% pass antenna7 C1
    %% after 0 ear-u08-c4
    %% pass antenna2 C4

    %% after 3.0 antenna2 C4
    %% caption 7 · Manual Mode again | The technician comes back and puts the analyzer into Manual Mode again while the carrier is on its way to the sampling point: the interface is in warning again and the timeout starts.
    %% after 3.0 antenna2 C4
    %% operator an tubes duration=9.5

    %% on antenna3 C4
    %% color #9333EA
    IF->>AN: EAC^U07<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000126
    AN->>IF: EAR^U08<br/>ECD-2: PR, ECD-5: 1<br/>SAC-3: SID-000126<br/>ECR-1: OK
    %% divert antenna3 C4
    %% after 1.5 antenna3 C4
    %% id manual-2
    AN->>IF: ESU^U01<br/>EQU-3: MM (Manual Mode)
    %% status an manual
    %% status interface warning
    IF->>AN: ACK^U01<br/>MSA-1: AA
    %% after 0.5 manual-2
    %% id timeout-2
    %% timer interface 100 limit=300 duration=3 label=Manual_Mode_timeout

    %% after 0 timeout-2
    %% caption 8 · Back before the timeout | The technician is done quickly: the analyzer leaves Manual Mode before the timeout expires. The carrier has reached the sampling point: the interface asks for its sampling.
    %% after 0 timeout-2
    AN->>IF: ESU^U01<br/>EQU-3: OP (Operating)
    %% status an normal
    %% status interface normal
    IF->>AN: ACK^U01<br/>MSA-1: AA
    %% after 0.4
    IF->>AN: EAC^U07<br/>ECD-2: SA, ECD-5: 1<br/>SAC-3: SID-000126
    %% pipette antenna4 duration=4 sid=SID-000126
    %% after 0.3 pipette antenna4
    AN->>IF: EAR^U08<br/>ECD-2: SA, ECD-5: 1<br/>SAC-3: SID-000126<br/>ECR-1: OK
    %% caption 9 · Sampled and released | Sampling is complete: the carrier goes on to the exit and the interface sends Release.
    %% pass antenna4 C4

    %% on antenna5 C4
    %% pass antenna5 C4

    %% on antenna7 C4
    IF->>AN: EAC^U07<br/>ECD-2: RL<br/>SAC-3: SID-000126
    AN->>IF: EAR^U08<br/>ECD-2: RL<br/>SAC-3: SID-000126<br/>ECR-1: OK
    %% pass antenna7 C4
