%% # Scene 10 — spur, a carrier expected in the spur is missing: Clear
%% # Same situation as scene 03, on a spur. C2 is believed to be diverted (Prepare is sent)
%% # but physically goes straight on the Main-Lane; its logical position is a dashed ghost
%% # ("C2L"). C3 queues on top of it. At the sampling point the interface sends Clear for
%% # C2 and, after the reply, Sample Acquisition for C3.
%% # Carrier flow: right to left on the Main-Lane; the spur rises perpendicular to it.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur
%% subtitle Spur — a carrier expected in the spur is missing, Clear
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,spur_in,queue2,queue,sampling,spur_top_in,spur_top_out,spur_out,pit_out,merge,iface_out,main_out,gone
    %% # The real C2: it is not diverted and goes straight on the Main-Lane.
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,merge,iface_out,main_out,gone color=#0EA5E9
    %% # Where the interface believes C2 is: diverted into the spur.
    %% carrier C2L SID-000124 route=nsd,pit_in,spur_in,queue2,queue,sampling color=#0EA5E9 ghost hidden tag=SID-000124_(expected)
    %% carrier C3 SID-000125 route=spawn,main_in,nsd,pit_in,spur_in,queue2,queue,sampling,spur_top_in,spur_top_out,spur_out,pit_out,merge,iface_out,main_out,gone color=#DB2777

    %% caption 1 · Three carriers | Three carriers holding sample tubes travel on the Main-Lane towards the spur of the analyzer interface.
    %% at 2.2
    %% move C1 to sampling
    %% on antenna1 C1
    %% caption 2 · Diverted — Prepare — Sample Acquisition | The first carrier is diverted into the spur without stopping (Prepare) and stopped by the gate on the sampling point: Sample Acquisition, then the analyzer aspirates.
    %% on antenna1 C1
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.1
    AN-->>IF: OK SampleId=SID-000123

    %% at 4.9
    %% move C2 to gone
    %% on antenna2
    IF->>AN: Sample Acquisition SampleId=SID-000123
    %% after 0.1 OK C1
    AN->>DMX: Query SampleId=SID-000123
    %% # C2 reaches the NSD: logically diverted (ghost appears), physically straight on.
    %% on antenna1 C2
    %% caption 3 · Physically straight, logically diverted | The second carrier should be diverted too, and the interface sends Prepare. But physically it goes straight on the Main-Lane: the dashed outline is where the interface believes it is.
    %% on antenna1 C2
    %% highlight nsd duration=2
    %% on antenna1 C2
    %% show C2L duration=0.4
    %% on antenna1 C2
    %% move C2L to queue
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.1 Sample Acquisition C1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 Query C1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.1 Prepare C2
    AN-->>IF: OK SampleId=SID-000124

    %% at 7.9
    %% move C3 to queue
    %% after 0.1 OK C1
    %% pipette sp duration=5
    %% on antenna1 C3
    %% caption 4 · Third carrier — one position, two carriers | The third carrier is diverted (Prepare) and stops in the queue on the same position as the second one: the second is not physically there, it went straight on along the Main-Lane.
    %% on antenna1 C3
    %% highlight nsd duration=2
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000125
    %% after 0.1 OK C2
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.1 Prepare C3
    AN-->>IF: OK SampleId=SID-000125
    %% after 0.1 Query C2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0.1
    AN->>DMX: Query SampleId=SID-000125

    %% after 0.3 pipette sp
    %% caption 5 · Sample Complete | Sampling is finished: Sample Complete. The first carrier is released, and the queue moves up to the sampling point.
    %% after 0.3 pipette sp
    AN->>IF: Sample Complete SampleId=SID-000123
    %% after 0.1 Query C3
    DMX-->>AN: Tests to perform SampleId=SID-000125
    %% after 0.1 Sample Complete C1
    %% for C1
    IF-->>AN: OK
    %% move C1 to gone
    %% after 0 OK C1
    %% move C2L to sampling
    %% after 0 OK C1
    %% move C3 to sampling
    %% after 0.2 antenna2 C3
    %% caption 6 · Clear | The interface expects the second sample at the sampling point, but finds the third one: the second never arrived. It sends Clear for the second sample and waits for the reply.
    %% after 0.2 antenna2 C3
    IF->>AN: Clear SampleId=SID-000124
    %% after 0.1
    AN-->>IF: OK SampleId=SID-000124
    %% hide C2L duration=0.6
    %% after 0.2 OK C2
    %% caption 7 · Sample Acquisition — Release | Only after the reply to Clear the interface sends Sample Acquisition for the third sample. Meanwhile the first carrier leaves the module: Release.
    %% after 0.2 OK C2
    IF->>AN: Sample Acquisition SampleId=SID-000125
    %% on antenna3
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1 Sample Acquisition C3
    %% for C3
    AN-->>IF: OK
    %% after 0.1 Release C1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 OK C3
    %% pipette sp duration=4.5
    %% after 0.2
    %% caption 8 · Back to normal | Sample Complete for the third sample: the carrier goes round the spur and, once it has left the module, the interface sends Release.
    %% after 0.2 pipette sp
    AN->>IF: Sample Complete SampleId=SID-000125
    %% after 0.1
    %% for C3
    IF-->>AN: OK
    %% move C3 to gone
    %% on antenna3
    IF->>AN: Release SampleId=SID-000125
    %% after 0.1
    %% for C3
    AN-->>IF: OK
    %% after 0.5
    %% caption 9 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 OK C3
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000125
