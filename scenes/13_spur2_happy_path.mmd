%% # Scene 13 — spur with one analyzer and two needles, happy path
%% # C1 needs both needles, C2 only needle 2: Prepare at the NSD, Prepare again at each
%% # divert that diverts it, one Sample Acquisition per needle with the Needle parameter.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with one analyzer and two sampling points — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone color=#0EA5E9

    %% caption 1 · One analyzer, two sampling points | The spur serves one analyzer with two needles, each on its own pit-lane. Which needles a sample needs depends on its tests: one of them, or both.
    %% at 2.5
    %% move C1 to nsd
    %% at 2.89
    %% move C2 to nsd
    %% on antenna1 C1
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000123
    %% on antenna1
    %% move C1 to d1
    %% on antenna1
    %% move C2 to d1
    %% on antenna1 C2
    %% highlight nsd duration=1.6
    %% on antenna1
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.2 Prepare C1
    AN-->>IF: OK SampleId=SID-000123
    %% on antenna2 C1
    %% highlight div1 duration=0.6
    %% on antenna2 C1
    %% caption 2 · Standard divert — Prepare again | Each carrier is diverted into the spur without stopping (Prepare), then stops at the divert and is read. The first needs needle 1: Prepare again and diverted. The second only needs needle 2: straight on.
    %% after 0.1 antenna2 C1
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0.2 Prepare C2
    AN-->>IF: OK SampleId=SID-000124
    %% after 0.6 antenna2 C1
    %% move C1 to s1
    %% on antenna2 C2
    %% highlight div1 duration=0.6
    %% after 0.2 OK C1
    AN->>DMX: Query SampleId=SID-000123
    %% after 0.401 antenna2 C2
    %% move C2 to d2
    %% after 0.1 Prepare C1
    %% for C1
    AN-->>IF: OK
    %% after 0.3 antenna3 C1
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=1
    %% on antenna4 C2
    %% highlight div2 duration=0.6
    %% after 0.1 antenna4 C2
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000124
    %% after 0.2 Query C1
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% after 0.6 antenna4 C2
    %% move C2 to s2
    %% after 0.1 Sample Acquisition C1
    %% for C1
    AN-->>IF: OK
    %% after 0.1 Prepare C2
    %% for C2
    AN-->>IF: OK
    %% after 0.1 Tests to perform C1
    AN->>DMX: Query SampleId=SID-000124
    %% after 0.2 antenna5 C2
    IF->>AN: Sample Acquisition SampleId=SID-000124 Needle=2
    %% after 0.1 OK C1
    %% pipette sp1 duration=4
    %% after 0.2 Query C2
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% after 0 Sample Acquisition C2
    %% caption 3 · Sample Acquisition with the needle id | There is one Sample Acquisition for each sampling point: the Needle parameter tells the analyzer which needle must come out. Sample Complete carries the same id.
    %% after 0.1 Sample Acquisition C2
    %% for C2
    AN-->>IF: OK
    %% after 0.1
    %% pipette sp2 duration=4
    %% after 0.2 pipette sp1
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=1
    %% after 0.1
    %% for C1
    IF-->>AN: OK
    %% after 0.2 pipette sp2
    AN->>IF: Sample Complete SampleId=SID-000124 Needle=2
    %% after 0 OK C1
    %% move C1 to d2
    %% after 0.1 Sample Complete C2
    %% for C2
    IF-->>AN: OK
    %% on antenna4 C1
    %% caption 4 · The first sample also needs needle 2 | Leaving needle 1 the carrier stops at the second divert: Prepare again. It also needs needle 2, so it enters the second pit-lane right away, even if the carrier ahead is still there.
    %% on antenna4 C1
    %% highlight div2 duration=0.6
    %% after 0.1 antenna4 C1
    %% color #9333EA
    IF->>AN: Prepare SampleId=SID-000123
    %% after 0 OK C2
    %% move C1 to s2
    %% after 0 OK C2
    %% move C2 to gone
    %% after 0.1 Prepare C1
    %% for C1
    AN-->>IF: OK
    %% after 0.2 antenna5 C1
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=2
    %% after 0.1
    %% for C1
    AN-->>IF: OK
    %% after 0.1
    %% pipette sp2 duration=4
    %% on antenna6 C2
    %% caption 5 · Release | Leaving the interface module each carrier gets one Release, however many needles sampled it.
    %% on antenna6
    IF->>AN: Release SampleId=SID-000124
    %% after 0.1
    %% for C2
    AN-->>IF: OK
    %% after 0.2 pipette sp2
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=2
    %% after 0.1
    %% for C1
    IF-->>AN: OK
    %% move C1 to gone
    %% on antenna6
    IF->>AN: Release SampleId=SID-000123
    %% after 0.1
    %% for C1
    AN-->>IF: OK
    %% after 0.5
    %% caption 6 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% after 0.5 OK C1
    AN->>DMX: Results SampleId=SID-000123
    %% after 0.2
    AN->>DMX: Results SampleId=SID-000124
