%% # Scene 13 — spur with one analyzer and two needles, happy path
%% # C1 needs both needles, C2 only needle 2: Prepare at the NSD, Prepare again at each
%% # divert that diverts it, one Sample Acquisition per needle with the Needle parameter.
%% # Carrier flow: right to left on the Main-Lane, up the spur, down the back branch.
%% # Coordinates are in a fixed 1920x1080 space (track panel: x 30..950, y 120..885).
%% # Points left of x=30 or right of x=950 are outside the panel (hidden).
%% geometry spur2
%% subtitle Spur with one analyzer and two sampling points — happy path
sequenceDiagram
    participant IF as Interface
    participant AN as Analyzer
    participant DMX as DMX

    %% carrier C1 SID-000123 route=main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,q2,pc1,q1,s1,pt1u,rj1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120
    %% carrier C2 SID-000124 route=spawn,main_in,nsd,pit_in,w1c,w1b,spur_in,w1,d1,w2,d2,qb2,pc2,qb1,s2,pt2u,rj2,top_r,top_l,back,po,merge,iface_out,main_out,gone speed=120 color=#0EA5E9

    %% at 0
    %% caption 1 · One analyzer, two sampling points | The spur serves one analyzer with two needles, each on its own pit-lane. Which needles a sample needs depends on its tests: one of them, or both.
    %% at 1
    %% move C1 to nsd ease=in
    %% at 1.6
    %% move C2 to nsd ease=linear
    %% when C1 at nsd
    %% caption 2 · Diverted — Prepare | Each carrier is diverted into the spur without stopping, and the interface sends Prepare to the analyzer.
    %% when C1 at nsd
    %% highlight nsd duration=1.6
    %% when C1 at nsd
    IF->>AN: Prepare SampleId=SID-000123
    %% when C1 at nsd
    %% move C1 to d1 ease=out
    %% when C2 at nsd
    %% move C2 to w1 ease=out
    %% when C2 at nsd
    %% highlight nsd duration=1.6
    %% when C2 at nsd
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare C1 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000123
    %% when prepare C2 sent
    %% delay 1.7
    AN-->>IF: OK SampleId=SID-000124
    %% when sample_ok C1 arrived
    %% delay 0.2
    AN->>DMX: Query SampleId=SID-000123
    %% when query C1 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000123
    %% when C1 at d1
    %% highlight div1 duration=0.6
    %% when C1 at d1
    %% caption 3 · Standard divert — Prepare again | Unlike at the entrance of the spur, here the carrier stops and is read. This sample needs needle 1: Prepare again, then it is diverted while the next carrier stops behind.
    %% when C1 at d1
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare_again C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when C1 at d1
    %% delay 0.6
    %% move C1 to s1 ease=inout
    %% when tests C1 arrived
    %% delay 0.1
    AN->>DMX: Query SampleId=SID-000124
    %% when C2 at w1
    %% delay 1.575
    %% move C2 to d1 ease=inout
    %% when query C2 sent
    %% delay 1.7
    DMX-->>AN: Tests to perform SampleId=SID-000124
    %% when C2 at d1
    %% highlight div1 duration=0.6
    %% when C2 at d1
    %% caption 4 · The next carrier goes straight on | The second carrier also stops and is read, but it only needs needle 2: it goes straight on to the second divert, where it gets Prepare again.
    %% when C2 at d1
    %% delay 0.401
    %% move C2 to d2 ease=inout
    %% when C1 at s1
    %% delay 0.3
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=1
    %% when sample_acquisition_needle C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when analyzer_ok C1 arrived
    %% delay 0.1
    %% pipette sp1 duration=4
    %% when C2 at d2
    %% highlight div2 duration=0.6
    %% when C2 at d2
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000124
    %% when prepare_again C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when C2 at d2
    %% delay 0.6
    %% move C2 to s2 ease=inout
    %% when pipette sp1 done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=1
    %% when sample_complete_needle C1 arrived
    %% delay 0.1
    %% for C1
    IF-->>AN: OK
    %% when C2 at s2
    %% delay 0.2
    IF->>AN: Sample Acquisition SampleId=SID-000124 Needle=2
    %% when sample_acquisition_needle C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when sample_acquisition_needle C2 sent
    %% delay 0.001
    %% caption 5 · Sample Acquisition with the needle id | There is one Sample Acquisition for each sampling point: the Needle parameter tells the analyzer which needle must come out. Sample Complete carries the same id.
    %% when interface_ok C1 sent
    %% move C1 to d2 ease=inout
    %% when analyzer_ok C2 arrived
    %% delay 0.1
    %% pipette sp2 duration=4
    %% when C1 at d2
    %% caption 6 · The first sample also needs needle 2 | Leaving needle 1 the carrier stops at the second divert: Prepare again. It also needs needle 2, so it enters the second pit-lane right away, even if the carrier ahead is still there.
    %% when C1 at d2
    %% highlight div2 duration=0.6
    %% when C1 at d2
    %% delay 0.1
    IF->>AN: Prepare SampleId=SID-000123
    %% when prepare_again C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when pipette sp2 done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000124 Needle=2
    %% when sample_complete_needle C2 arrived
    %% delay 0.1
    %% for C2
    IF-->>AN: OK
    %% when interface_ok C2 sent
    %% move C1 to s2 ease=inout
    %% when interface_ok C2 sent
    %% move C2 to pt2u ease=in
    %% when C2 at pt2u
    %% move C2 to merge ease=linear
    %% when C1 at s2
    %% delay 0.2
    IF->>AN: Sample Acquisition SampleId=SID-000123 Needle=2
    %% when sample_acquisition_needle C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when analyzer_ok C1 arrived
    %% delay 0.1
    %% pipette sp2 duration=4
    %% when pipette sp2 done
    %% delay 0.2
    AN->>IF: Sample Complete SampleId=SID-000123 Needle=2
    %% when sample_complete_needle C1 arrived
    %% delay 0.1
    %% for C1
    IF-->>AN: OK
    %% when interface_ok C1 sent
    %% move C1 to pt2u ease=in
    %% when C2 at merge
    %% delay 0.001
    %% move C2 to gone ease=out
    %% when C2 at iface_out
    %% caption 7 · Release | Leaving the interface module each carrier gets one Release, however many needles sampled it.
    %% when C2 at iface_out
    IF->>AN: Release SampleId=SID-000124
    %% when release C2 arrived
    %% delay 0.1
    %% for C2
    AN-->>IF: OK
    %% when C1 at pt2u
    %% move C1 to merge ease=linear
    %% when C1 at merge
    %% delay 0.001
    %% move C1 to gone ease=out
    %% when C1 at iface_out
    IF->>AN: Release SampleId=SID-000123
    %% when release C1 arrived
    %% delay 0.1
    %% for C1
    AN-->>IF: OK
    %% when analyzer_ok C1 arrived
    %% delay 0.5
    %% caption 8 · Results | Later, when the analysis is complete, the analyzer sends the results to DMX.
    %% when analyzer_ok C1 arrived
    %% delay 0.5
    AN->>DMX: Results SampleId=SID-000123
    %% when results C1 arrived
    %% delay 0.2
    AN->>DMX: Results SampleId=SID-000124
