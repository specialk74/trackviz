{
  "Scene skeleton": {
    "prefix": "tv-scene",
    "body": [
      "%% # ${1:Scene title}",
      "%% geometry ${2|sampling,sampling_queue,sampling_queue2,turnstile,turnstile_queue,spur,spur2|}",
      "%% subtitle ${3:What the scene shows}",
      "sequenceDiagram",
      "    participant IF as Interface",
      "    participant AN as Analyzer",
      "    participant DMX as DMX",
      "",
      "    %% carrier id=C1 sid=SID-000123 route=${4:main_in,pit,main_out}",
      "",
      "    %% caption 1 · ${5:Title} | ${6:Text}",
      "    %% at 2",
      "    %% move C1 to ${7:sampling}",
      "    %% on antenna1",
      "    IF->>AN: Prepare SampleId=SID-000123",
      "    %% after 0.1",
      "    AN-->>IF: OK SampleId=SID-000123",
      "    $0"
    ],
    "description": "A new scene: geometry, one carrier, the first caption and a Prepare"
  },
  "geometry": {
    "prefix": "tv-geometry",
    "body": [
      "%% geometry ${1|sampling,sampling_queue,sampling_queue2,turnstile,turnstile_queue,spur,spur2|}"
    ],
    "description": "Reads common/<name>.mmd: points, lanes, devices, antennas"
  },
  "include": {
    "prefix": "tv-include",
    "body": [
      "%% include ${1:common/file.mmd}"
    ],
    "description": "The directives of another file (only %% lines)"
  },
  "title": {
    "prefix": "tv-title",
    "body": [
      "%% title ${1:Title}"
    ],
    "description": "Title of the video"
  },
  "subtitle": {
    "prefix": "tv-subtitle",
    "body": [
      "%% subtitle ${1:Subtitle}"
    ],
    "description": "Subtitle of the video"
  },
  "carrier": {
    "prefix": "tv-carrier",
    "body": [
      "%% carrier id=${1:C1} sid=${2:SID-000123} route=${3:spawn,pit,gone}"
    ],
    "description": "A carrier with a sample; route = points and lane ids, the way between is filled in. Options: needle=1|2|both, color=#hex, tag=text, ghost, hidden"
  },
  "empty carrier": {
    "prefix": "tv-carrier-empty",
    "body": [
      "%% carrier id=${1:E} route=${2:spawn,gone}"
    ],
    "description": "An empty carrier: no tube, no sample"
  },
  "ghost carrier": {
    "prefix": "tv-carrier-ghost",
    "body": [
      "%% carrier id=${1:C2L} sid=${2:SID-000124} route=${3:nsd,sampling} ghost hidden tag=${4:SID-000124_(expected)}"
    ],
    "description": "Where the interface believes a carrier is (dashed outline); shown with 'show'"
  },
  "on antenna": {
    "prefix": "tv-on",
    "body": [
      "%% on ${1|antenna1,antenna2,antenna3,antenna4,antenna5,antenna6|}"
    ],
    "description": "The next step starts when its carrier (SampleId of the message, or the one it moves) is over the antenna"
  },
  "on antenna carrier": {
    "prefix": "tv-on-carrier",
    "body": [
      "%% on ${1|antenna1,antenna2,antenna3,antenna4,antenna5,antenna6|} ${2:C1}"
    ],
    "description": "The next step starts when this carrier is over the antenna"
  },
  "after": {
    "prefix": "tv-after",
    "body": [
      "%% after ${1:0.1}"
    ],
    "description": "The next step starts that many seconds after the step before has ended"
  },
  "after message": {
    "prefix": "tv-after-message",
    "body": [
      "%% after ${1:0.1} ${2:OK} ${3:C1}"
    ],
    "description": "N seconds after the latest message with that text (for that carrier) has arrived"
  },
  "after antenna": {
    "prefix": "tv-after-antenna",
    "body": [
      "%% after ${1:0.2} ${2|antenna1,antenna2,antenna3,antenna4,antenna5,antenna6|} ${3:C1}"
    ],
    "description": "N seconds after the carrier is over the antenna"
  },
  "after action": {
    "prefix": "tv-after-action",
    "body": [
      "%% after ${1:0.3} ${2|pipette,rotate,needle|} ${3:sp}"
    ],
    "description": "N seconds after that action on the device ends"
  },
  "at": {
    "prefix": "tv-at",
    "body": [
      "%% at ${1:2}"
    ],
    "description": "The next step starts at that second of the video"
  },
  "color": {
    "prefix": "tv-color",
    "body": [
      "%% color ${1:#9333EA}"
    ],
    "description": "Color of the next message (#9333EA: the purple Prepare)"
  },
  "for": {
    "prefix": "tv-for",
    "body": [
      "%% for ${1:C1}"
    ],
    "description": "The carrier of the next message, when its text has no SampleId (e.g. OK)"
  },
  "duration": {
    "prefix": "tv-duration",
    "body": [
      "%% duration ${1:2.6}"
    ],
    "description": "Duration of the next message or note"
  },
  "move": {
    "prefix": "tv-move",
    "body": [
      "%% move ${1:C1} to ${2:sampling}"
    ],
    "description": "The carrier sets off towards the point; the physics makes it wait behind others. Options: runaway, ease=, speed=, duration="
  },
  "pass": {
    "prefix": "tv-pass",
    "body": [
      "%% pass ${1:sp}"
    ],
    "description": "The carrier stopped on the device sets off to the next stop of its route (gated antenna, turnstile entry) or its end"
  },
  "pipette": {
    "prefix": "tv-pipette",
    "body": [
      "%% pipette ${1:sp} duration=${2:4.5} sid=${3:SID-000123}"
    ],
    "description": "The analyzer aspirates; adds the note 'Pipetting Analyzer - SampleId=...'. A Note right after it replaces the text"
  },
  "rotate": {
    "prefix": "tv-rotate",
    "body": [
      "%% rotate ${1:ts}"
    ],
    "description": "The turnstile turns by one position (2 s)"
  },
  "needle": {
    "prefix": "tv-needle",
    "body": [
      "%% needle ${1:sp} ${2|down,up|}"
    ],
    "description": "The analyzer needle goes down into the tube or back up"
  },
  "status": {
    "prefix": "tv-status",
    "body": [
      "%% status ${1:analyzer} ${2|error,ready,normal|}"
    ],
    "description": "State of the analyzer, of a needle (sampling device) or of a zone"
  },
  "operator": {
    "prefix": "tv-operator",
    "body": [
      "%% operator ${1:analyzer} duration=${2:7}"
    ],
    "description": "An operator walks to the analyzer for a recovery"
  },
  "highlight": {
    "prefix": "tv-highlight",
    "body": [
      "%% highlight ${1:ts} duration=${2:1.5}"
    ],
    "description": "Makes a device shine (antennas light their device by themselves)"
  },
  "show": {
    "prefix": "tv-show",
    "body": [
      "%% show ${1:C2L} duration=${2:0.4}"
    ],
    "description": "A hidden carrier fades in"
  },
  "hide": {
    "prefix": "tv-hide",
    "body": [
      "%% hide ${1:C2L} duration=${2:0.6}"
    ],
    "description": "A carrier fades out"
  },
  "wait": {
    "prefix": "tv-wait",
    "body": [
      "%% wait ${1:1}"
    ],
    "description": "A pause of that many seconds"
  },
  "caption": {
    "prefix": "tv-caption",
    "body": [
      "%% caption ${1:1 · Title} | ${2:Text}"
    ],
    "description": "A caption (it stays until the next one)"
  },
  "note": {
    "prefix": "tv-note",
    "body": [
      "Note over AN: ${1:Analysis}"
    ],
    "description": "A note on the analyzer lifeline"
  },
  "comment": {
    "prefix": "tv-comment",
    "body": [
      "%% # ${1:comment}"
    ],
    "description": "A plain comment"
  },
  "message prepare": {
    "prefix": "tv-msg-prepare",
    "body": [
      "IF->>AN: Prepare SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'prepare': Prepare SampleId={SampleId}"
  },
  "message prepare_again": {
    "prefix": "tv-msg-prepare_again",
    "body": [
      "%% color #9333EA",
      "IF->>AN: Prepare SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'prepare_again': Prepare SampleId={SampleId}"
  },
  "message sample_ok": {
    "prefix": "tv-msg-sample_ok",
    "body": [
      "AN-->>IF: OK SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'sample_ok': OK SampleId={SampleId}"
  },
  "message sample_acquisition": {
    "prefix": "tv-msg-sample_acquisition",
    "body": [
      "IF->>AN: Sample Acquisition SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'sample_acquisition': Sample Acquisition SampleId={SampleId}"
  },
  "message sample_acquisition_needle": {
    "prefix": "tv-msg-sample_acquisition_needle",
    "body": [
      "IF->>AN: Sample Acquisition SampleId=${1:SID-000123} Needle=${2:1}"
    ],
    "description": "Library message 'sample_acquisition_needle': Sample Acquisition SampleId={SampleId} Needle={Needle}"
  },
  "message sample_complete": {
    "prefix": "tv-msg-sample_complete",
    "body": [
      "AN->>IF: Sample Complete SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'sample_complete': Sample Complete SampleId={SampleId}"
  },
  "message sample_complete_needle": {
    "prefix": "tv-msg-sample_complete_needle",
    "body": [
      "AN->>IF: Sample Complete SampleId=${1:SID-000123} Needle=${2:1}"
    ],
    "description": "Library message 'sample_complete_needle': Sample Complete SampleId={SampleId} Needle={Needle}"
  },
  "message release": {
    "prefix": "tv-msg-release",
    "body": [
      "IF->>AN: Release SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'release': Release SampleId={SampleId}"
  },
  "message query": {
    "prefix": "tv-msg-query",
    "body": [
      "AN->>DMX: Query SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'query': Query SampleId={SampleId}"
  },
  "message tests": {
    "prefix": "tv-msg-tests",
    "body": [
      "DMX-->>AN: Tests to perform SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'tests': Tests to perform SampleId={SampleId}"
  },
  "message results": {
    "prefix": "tv-msg-results",
    "body": [
      "AN->>DMX: Results SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'results': Results SampleId={SampleId}"
  },
  "message status_error": {
    "prefix": "tv-msg-status_error",
    "body": [
      "AN->>IF: Status State=Error"
    ],
    "description": "Library message 'status_error': Status State=Error"
  },
  "message status_error_needle": {
    "prefix": "tv-msg-status_error_needle",
    "body": [
      "AN->>IF: Status State=Error Needle=${1:1}"
    ],
    "description": "Library message 'status_error_needle': Status State=Error Needle={Needle}"
  },
  "message status_ready": {
    "prefix": "tv-msg-status_ready",
    "body": [
      "AN->>IF: Status State=Ready"
    ],
    "description": "Library message 'status_ready': Status State=Ready"
  },
  "message status_ready_needle": {
    "prefix": "tv-msg-status_ready_needle",
    "body": [
      "AN->>IF: Status State=Ready Needle=${1:1}"
    ],
    "description": "Library message 'status_ready_needle': Status State=Ready Needle={Needle}"
  },
  "message interface_ok": {
    "prefix": "tv-msg-interface_ok",
    "body": [
      "IF-->>AN: OK"
    ],
    "description": "Library message 'interface_ok': OK"
  },
  "message clear": {
    "prefix": "tv-msg-clear",
    "body": [
      "IF->>AN: Clear SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'clear': Clear SampleId={SampleId}"
  },
  "message cancel": {
    "prefix": "tv-msg-cancel",
    "body": [
      "IF->>AN: Cancel SampleId=${1:SID-000123}"
    ],
    "description": "Library message 'cancel': Cancel SampleId={SampleId}"
  },
  "message clear_all": {
    "prefix": "tv-msg-clear_all",
    "body": [
      "IF->>AN: Clear All"
    ],
    "description": "Library message 'clear_all': Clear All"
  },
  "message analyzer_ok": {
    "prefix": "tv-msg-analyzer_ok",
    "body": [
      "AN-->>IF: OK"
    ],
    "description": "Library message 'analyzer_ok': OK"
  }
}